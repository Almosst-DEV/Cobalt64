diff --git a/include/darwin/libsync.h b/include/darwin/libsync.h
new file mode 100644
index 00000000000..f13d990003e
--- /dev/null
+++ b/include/darwin/libsync.h
@@ -0,0 +1,32 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Stand-in for libdrm's libsync.h on macOS (RADV, src/amd/common/darwin).
+ * There are no Linux sync_file fds on macOS: everything reports -ENOSYS.
+ * The Darwin sync provider never hands out a sync_file, so these are only
+ * reached if RADV is asked to merge or wait on one.
+ */
+#ifndef DARWIN_LIBSYNC_H
+#define DARWIN_LIBSYNC_H
+
+#include <errno.h>
+
+static inline int
+sync_wait(int fd, int timeout)
+{
+   return -ENOSYS;
+}
+
+static inline int
+sync_merge(const char *name, int fd1, int fd2)
+{
+   return -ENOSYS;
+}
+
+static inline int
+sync_accumulate(const char *name, int *fd1, int fd2)
+{
+   return -ENOSYS;
+}
+
+#endif
diff --git a/include/darwin/xf86drm.h b/include/darwin/xf86drm.h
new file mode 100644
index 00000000000..98626503d51
--- /dev/null
+++ b/include/darwin/xf86drm.h
@@ -0,0 +1,54 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Stand-in for libdrm's xf86drm.h on macOS (RADV, src/amd/common/darwin).
+ * There is no DRM node on macOS, so everything libdrm would answer from a
+ * device node is answered as "no device" by util/libdrm.h's shim; this file
+ * adds only what util/os_drm.h and RADV need on top of it.
+ */
+#ifndef DARWIN_XF86DRM_H
+#define DARWIN_XF86DRM_H
+
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/types.h>
+
+#include "drm-uapi/drm.h"
+#include "util/libdrm.h"
+
+#ifndef DRM_IOC_READ
+#define DRM_IOC_VOID  IOC_VOID
+#define DRM_IOC_READ  IOC_OUT
+#define DRM_IOC_WRITE IOC_IN
+#endif
+#ifndef DRM_IOC
+#define DRM_IOC(dir, group, nr, size) _IOC(dir, group, nr, size)
+#endif
+
+static inline int
+drmIoctl(int fd, unsigned long request, void *arg)
+{
+   return -1;
+}
+
+static inline int
+drmGetCap(int fd, uint64_t capability, uint64_t *value)
+{
+   return -EINVAL;
+}
+
+static inline char *
+drmGetFormatModifierName(uint64_t modifier)
+{
+   return strdup("(unavailable: no libdrm)");
+}
+
+static inline char *
+drmGetPrimaryDeviceNameFromFd(int fd)
+{
+   return NULL;
+}
+
+#endif
