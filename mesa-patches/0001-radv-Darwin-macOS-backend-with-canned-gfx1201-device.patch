diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
new file mode 100644
index 00000000000..9815937af3e
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -0,0 +1,371 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Darwin backend of the ac_drm_* layer.  See ac_darwin_drm.h.
+ */
+
+#include "ac_darwin_drm.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "common/amd_family.h"
+#include "common/amdgpu_devices.h"
+#include "util/macros.h"
+#include "util/u_math.h"
+#include "util/u_sync_provider.h"
+
+/* Kernel-facing DRM version reported to RADV: the minimum the amdgpu winsys
+ * accepts (ac_query_gpu_info refuses anything older). */
+#define ACD_DRM_MAJOR AC_AMDGPU_DRM_MAJOR
+#define ACD_DRM_MINOR AC_AMDGPU_DRM_MINOR
+
+/* amdgpu.ids: 7550,C0 */
+#define ACD_MARKETING_NAME "AMD Radeon RX 9070 XT"
+
+/* S1a stand-in: with RADV_DARWIN_HOST_BO=1 a BO is anonymous host memory and
+ * GEM_VA / GEM_WAIT_IDLE succeed without touching a GPU, so vkCreateDevice can
+ * get past RADV's own BO allocations and reach the first real kernel stub (CS
+ * submit).  Without it every BO call is a kernel stub.  Nothing here is GPU
+ * visible; S1c replaces it with kext-backed BOs. */
+struct amdgpu_bo {
+   uint64_t size;
+   uint32_t handle;
+   void *cpu;
+};
+
+struct acd_device {
+   bool host_bo;
+   uint32_t next_bo_handle;
+   const struct amdgpu_device *canned;
+   struct amdgpu_va_manager *va_mgr;
+   struct util_sync_provider *sync;
+   uint32_t next_ctx_id;
+};
+
+#define ACD_KERNEL_STUB(what)                                                                     \
+   do {                                                                                           \
+      fprintf(stderr, "radv-darwin: kernel stub '%s' -> -ENODEV (no kernel driver, S1a)\n", what); \
+      return -ENODEV;                                                                             \
+   } while (0)
+
+static const struct amdgpu_device *
+find_canned(const char *name)
+{
+   for (uint32_t i = 0; i < num_amdgpu_devices; i++) {
+      if (!strcmp(amdgpu_devices[i].name, name))
+         return &amdgpu_devices[i];
+   }
+   return NULL;
+}
+
+int
+acd_device_initialize(uint32_t *drm_major, uint32_t *drm_minor, acd_device_handle *out)
+{
+   struct acd_device *dev = calloc(1, sizeof(*dev));
+   if (!dev)
+      return -ENOMEM;
+
+   dev->canned = find_canned("gfx1201");
+   if (!dev->canned) {
+      free(dev);
+      return -ENODEV;
+   }
+
+   dev->sync = acd_sync_provider_create();
+   dev->va_mgr = amdgpu_va_manager_alloc();
+   if (!dev->sync || !dev->va_mgr) {
+      free(dev->va_mgr);
+      if (dev->sync)
+         dev->sync->finalize(dev->sync);
+      free(dev);
+      return -ENOMEM;
+   }
+
+   const struct drm_amdgpu_info_device *di = &dev->canned->dev;
+   /* gfx12: RADV needs half of the VA range reserved for PRT, as on Linux. */
+   amdgpu_va_manager_init2(dev->va_mgr, di->virtual_address_offset, di->virtual_address_max,
+                           di->high_va_offset, di->high_va_max, di->virtual_address_alignment,
+                           AMDGPU_VA_MGR_RESERVE_HALF_VA_FOR_PRT);
+
+   const char *host_bo = getenv("RADV_DARWIN_HOST_BO");
+   dev->host_bo = host_bo && host_bo[0] == '1';
+   dev->next_bo_handle = 1;
+   dev->next_ctx_id = 1;
+   *drm_major = ACD_DRM_MAJOR;
+   *drm_minor = ACD_DRM_MINOR;
+   *out = dev;
+   return 0;
+}
+
+void
+acd_device_deinitialize(acd_device_handle dev)
+{
+   amdgpu_va_manager_deinit(dev->va_mgr);
+   free(dev->va_mgr);
+   /* dev->sync is finalized by ac_drm_device_deinitialize() */
+   free(dev);
+}
+
+struct util_sync_provider *
+acd_device_get_sync_provider(acd_device_handle dev)
+{
+   return dev->sync;
+}
+
+const char *
+acd_get_marketing_name(acd_device_handle dev)
+{
+   return ACD_MARKETING_NAME;
+}
+
+int
+acd_query_sw_info(acd_device_handle dev, enum amdgpu_sw_info info, void *value)
+{
+   switch (info) {
+   case amdgpu_sw_info_address32_hi:
+      *(uint32_t *)value = (dev->canned->dev.high_va_offset ? dev->canned->dev.high_va_offset
+                                                             : dev->canned->dev.virtual_address_offset) >> 32;
+      return 0;
+   case amdgpu_sw_info_address_prt_wa_control_bit:
+      return amdgpu_va_manager_query_sw_info(dev->va_mgr, amdgpu_va_manager_sw_info_address_prt_wa_control_bit,
+                                             value);
+   }
+   return -EINVAL;
+}
+
+int
+acd_va_range_alloc(acd_device_handle dev, enum amdgpu_gpu_va_range va_range_type, uint64_t size,
+                   uint64_t va_base_alignment, uint64_t va_base_required, uint64_t *va_base_allocated,
+                   amdgpu_va_handle *va_range_handle, uint64_t flags)
+{
+   return amdgpu_va_range_alloc2(dev->va_mgr, va_range_type, size, va_base_alignment, va_base_required,
+                                 va_base_allocated, va_range_handle, flags);
+}
+
+int
+acd_va_range_query(acd_device_handle dev, enum amdgpu_gpu_va_range type, uint64_t *start, uint64_t *end)
+{
+   if (type != amdgpu_gpu_va_range_general)
+      return -EINVAL;
+   *start = dev->canned->dev.virtual_address_offset;
+   *end = dev->canned->dev.virtual_address_max;
+   return 0;
+}
+
+/* ---- AMDGPU_INFO: canned, the same nine ids the Linux drm-shim answers ---- */
+
+static void
+info_read_mmr_reg(const struct amdgpu_device *d, uint32_t reg, uint32_t count, uint32_t instance,
+                  uint32_t *vals)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      bool found = false;
+      uint32_t val = 0;
+      for (uint32_t j = 0; j < d->mmr_reg_count; j++) {
+         const uint32_t *triple = &d->mmr_regs[j * 3];
+         if (triple[0] == reg + i && triple[1] == instance) {
+            val = triple[2];
+            found = true;
+            break;
+         }
+      }
+      if (!found)
+         fprintf(stderr, "radv-darwin: canned mmr reg 0x%04x instance 0x%x unknown, returning 0\n", reg + i,
+                 instance);
+      vals[i] = val;
+   }
+}
+
+static int
+acd_info(struct acd_device *dev, const struct drm_amdgpu_info *info)
+{
+   const struct amdgpu_device *d = dev->canned;
+   void *out = (void *)(uintptr_t)info->return_pointer;
+
+   switch (info->query) {
+   case AMDGPU_INFO_ACCEL_WORKING:
+      *(uint32_t *)out = 1;
+      return 0;
+   case AMDGPU_INFO_HW_IP_INFO:
+      if (info->query_hw_ip.type == AMDGPU_HW_IP_GFX)
+         *(struct drm_amdgpu_info_hw_ip *)out = d->hw_ip_gfx;
+      else if (info->query_hw_ip.type == AMDGPU_HW_IP_COMPUTE)
+         *(struct drm_amdgpu_info_hw_ip *)out = d->hw_ip_compute;
+      return 0;
+   case AMDGPU_INFO_HW_IP_COUNT:
+      *(uint32_t *)out = 1;
+      return 0;
+   case AMDGPU_INFO_FW_VERSION:
+      if (info->query_fw.fw_type == AMDGPU_INFO_FW_GFX_ME)
+         *(struct drm_amdgpu_info_firmware *)out = d->fw_gfx_me;
+      else if (info->query_fw.fw_type == AMDGPU_INFO_FW_GFX_PFP)
+         *(struct drm_amdgpu_info_firmware *)out = d->fw_gfx_pfp;
+      else if (info->query_fw.fw_type == AMDGPU_INFO_FW_GFX_MEC)
+         *(struct drm_amdgpu_info_firmware *)out = d->fw_gfx_mec;
+      return 0;
+   case AMDGPU_INFO_READ_MMR_REG:
+      info_read_mmr_reg(d, info->read_mmr_reg.dword_offset, info->read_mmr_reg.count,
+                        info->read_mmr_reg.instance, out);
+      return 0;
+   case AMDGPU_INFO_DEV_INFO:
+      *(struct drm_amdgpu_info_device *)out = d->dev;
+      return 0;
+   case AMDGPU_INFO_MEMORY: {
+      struct drm_amdgpu_memory_info *m = out;
+      *m = d->mem;
+      /* as drm-shim: keep only total_heap_size, no usage */
+      m->vram.usable_heap_size = m->vram.total_heap_size;
+      m->vram.heap_usage = 0;
+      m->vram.max_allocation = m->vram.total_heap_size * 3 / 4;
+      m->cpu_accessible_vram.usable_heap_size = m->cpu_accessible_vram.total_heap_size;
+      m->cpu_accessible_vram.heap_usage = 0;
+      m->cpu_accessible_vram.max_allocation = m->cpu_accessible_vram.total_heap_size * 3 / 4;
+      m->gtt.usable_heap_size = m->gtt.total_heap_size;
+      m->gtt.heap_usage = 0;
+      m->gtt.max_allocation = m->gtt.total_heap_size * 3 / 4;
+      return 0;
+   }
+   case AMDGPU_INFO_VIDEO_CAPS:
+      return 0;
+   default:
+      /* the drm-shim also answers -EINVAL here */
+      return -EINVAL;
+   }
+}
+
+/* ---- DRM_AMDGPU_* command emulation ---- */
+
+int
+acd_ioctl(acd_device_handle dev, unsigned cmd_index, void *data, unsigned size)
+{
+   switch (cmd_index) {
+   case DRM_AMDGPU_INFO:
+      return acd_info(dev, data);
+
+   case DRM_AMDGPU_CTX: {
+      /* Userspace-only: RADV's context is an id for the seqno space. */
+      union drm_amdgpu_ctx *args = data;
+      switch (args->in.op) {
+      case AMDGPU_CTX_OP_ALLOC_CTX:
+         memset(&args->out, 0, sizeof(args->out));
+         args->out.alloc.ctx_id = dev->next_ctx_id++;
+         return 0;
+      case AMDGPU_CTX_OP_FREE_CTX:
+         return 0;
+      case AMDGPU_CTX_OP_QUERY_STATE2:
+         memset(&args->out, 0, sizeof(args->out));
+         return 0;
+      case AMDGPU_CTX_OP_GET_STABLE_PSTATE:
+      case AMDGPU_CTX_OP_SET_STABLE_PSTATE:
+         memset(&args->out, 0, sizeof(args->out));
+         return 0;
+      default:
+         return -EINVAL;
+      }
+   }
+
+   case DRM_AMDGPU_VM:
+      /* The VMID is static per client in the kext design. */
+      return 0;
+
+   case DRM_AMDGPU_GEM_VA:
+      if (dev->host_bo)
+         return 0;
+      ACD_KERNEL_STUB("GEM_VA (BO map/unmap)");
+   case DRM_AMDGPU_GEM_METADATA:
+      ACD_KERNEL_STUB("GEM_METADATA");
+   case DRM_AMDGPU_GEM_OP:
+      ACD_KERNEL_STUB("GEM_OP");
+   case DRM_AMDGPU_GEM_WAIT_IDLE:
+      if (dev->host_bo)
+         return 0; /* out.status stays 0: idle */
+      ACD_KERNEL_STUB("GEM_WAIT_IDLE (bo_wait_for_idle)");
+   case DRM_AMDGPU_CS:
+      ACD_KERNEL_STUB("CS submit");
+   case DRM_AMDGPU_WAIT_CS:
+      ACD_KERNEL_STUB("WAIT_CS (fence wait)");
+   case DRM_AMDGPU_USERQ:
+   case DRM_AMDGPU_USERQ_SIGNAL:
+   case DRM_AMDGPU_USERQ_WAIT:
+      ACD_KERNEL_STUB("userqueue");
+   default:
+      fprintf(stderr, "radv-darwin: unhandled DRM_AMDGPU command %u -> -ENOSYS\n", cmd_index);
+      return -ENOSYS;
+   }
+}
+
+int
+acd_bo_alloc(acd_device_handle dev, struct amdgpu_bo_alloc_request *req, amdgpu_bo_handle *bo)
+{
+   if (!dev->host_bo)
+      ACD_KERNEL_STUB("BO alloc");
+
+   struct amdgpu_bo *b = calloc(1, sizeof(*b));
+   if (!b)
+      return -ENOMEM;
+   uint64_t align = req->phys_alignment > 4096 ? req->phys_alignment : 4096;
+   uint64_t size = align64(req->alloc_size, 4096);
+   if (posix_memalign(&b->cpu, align, size)) {
+      free(b);
+      return -ENOMEM;
+   }
+   memset(b->cpu, 0, size);
+   b->size = size;
+   b->handle = dev->next_bo_handle++;
+   *bo = b;
+   return 0;
+}
+
+int
+acd_bo_export(acd_device_handle dev, amdgpu_bo_handle bo, enum amdgpu_bo_handle_type type,
+              uint32_t *shared_handle)
+{
+   if (dev->host_bo && (type == amdgpu_bo_handle_type_kms || type == amdgpu_bo_handle_type_kms_noimport)) {
+      *shared_handle = bo->handle;
+      return 0;
+   }
+   ACD_KERNEL_STUB("BO export");
+}
+
+int
+acd_bo_import(acd_device_handle dev, enum amdgpu_bo_handle_type type, uint32_t shared_handle,
+              struct amdgpu_bo_import_result *result)
+{
+   ACD_KERNEL_STUB("BO import");
+}
+
+int
+acd_bo_free(acd_device_handle dev, amdgpu_bo_handle bo)
+{
+   if (!dev->host_bo)
+      ACD_KERNEL_STUB("BO free");
+   free(bo->cpu);
+   free(bo);
+   return 0;
+}
+
+int
+acd_bo_cpu_map(acd_device_handle dev, amdgpu_bo_handle bo, void **cpu)
+{
+   if (!dev->host_bo)
+      ACD_KERNEL_STUB("BO cpu map");
+   *cpu = bo->cpu;
+   return 0;
+}
+
+int
+acd_bo_cpu_unmap(acd_device_handle dev, amdgpu_bo_handle bo)
+{
+   if (!dev->host_bo)
+      ACD_KERNEL_STUB("BO cpu unmap");
+   return 0;
+}
+
+int
+acd_create_bo_from_user_mem(acd_device_handle dev, void *cpu, uint64_t size, amdgpu_bo_handle *bo)
+{
+   ACD_KERNEL_STUB("BO from user memory");
+}
diff --git a/src/amd/common/darwin/ac_darwin_drm.h b/src/amd/common/darwin/ac_darwin_drm.h
new file mode 100644
index 00000000000..7da3aa411a2
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_drm.h
@@ -0,0 +1,64 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Darwin backend of the ac_drm_* layer (ac_linux_drm.c), for RADV on macOS.
+ *
+ * There is no DRM node and no libdrm on macOS.  S1a state: every device-info
+ * query is answered from the canned gfx1201 table (amd/common/amdgpu_devices.c,
+ * the table the Linux drm-shim serves), everything that only needs userspace
+ * (VA manager, contexts, syncobjs) works, and everything that would need the
+ * kernel driver returns -ENODEV with a log line ("kernel stub").
+ */
+#ifndef AC_DARWIN_DRM_H
+#define AC_DARWIN_DRM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "drm-uapi/amdgpu_drm.h"
+#include "amdgpu.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct util_sync_provider;
+struct acd_device;
+typedef struct acd_device *acd_device_handle;
+
+int acd_device_initialize(uint32_t *drm_major, uint32_t *drm_minor, acd_device_handle *dev);
+void acd_device_deinitialize(acd_device_handle dev);
+struct util_sync_provider *acd_device_get_sync_provider(acd_device_handle dev);
+
+/* Emulates the DRM_AMDGPU_* command ioctls that ac_linux_drm.c issues. */
+int acd_ioctl(acd_device_handle dev, unsigned cmd_index, void *data, unsigned size);
+
+const char *acd_get_marketing_name(acd_device_handle dev);
+int acd_query_sw_info(acd_device_handle dev, enum amdgpu_sw_info info, void *value);
+int acd_va_range_alloc(acd_device_handle dev, enum amdgpu_gpu_va_range va_range_type,
+                       uint64_t size, uint64_t va_base_alignment, uint64_t va_base_required,
+                       uint64_t *va_base_allocated, amdgpu_va_handle *va_range_handle,
+                       uint64_t flags);
+int acd_va_range_query(acd_device_handle dev, enum amdgpu_gpu_va_range type, uint64_t *start,
+                       uint64_t *end);
+
+/* Kernel stubs (S1c). */
+int acd_bo_alloc(acd_device_handle dev, struct amdgpu_bo_alloc_request *req, amdgpu_bo_handle *bo);
+int acd_bo_export(acd_device_handle dev, amdgpu_bo_handle bo, enum amdgpu_bo_handle_type type,
+                  uint32_t *shared_handle);
+int acd_bo_import(acd_device_handle dev, enum amdgpu_bo_handle_type type, uint32_t shared_handle,
+                  struct amdgpu_bo_import_result *result);
+int acd_bo_free(acd_device_handle dev, amdgpu_bo_handle bo);
+int acd_bo_cpu_map(acd_device_handle dev, amdgpu_bo_handle bo, void **cpu);
+int acd_bo_cpu_unmap(acd_device_handle dev, amdgpu_bo_handle bo);
+int acd_create_bo_from_user_mem(acd_device_handle dev, void *cpu, uint64_t size,
+                                amdgpu_bo_handle *bo);
+
+/* Userspace sync provider (ac_darwin_sync.c). */
+struct util_sync_provider *acd_sync_provider_create(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/amd/common/darwin/ac_darwin_sync.c b/src/amd/common/darwin/ac_darwin_sync.c
new file mode 100644
index 00000000000..67548cb469f
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_sync.c
@@ -0,0 +1,327 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Userspace sync provider for the Darwin ac_drm backend: binary and timeline
+ * syncobjs kept entirely in this process (there is no DRM syncobj on macOS).
+ * S1a: objects are signalled by the CPU only (signal / timeline_signal /
+ * CREATE_SIGNALED / transfer); S1c signals them from kext sequence numbers.
+ * sync_file and fd import/export are not available (-ENOSYS).
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "drm-uapi/drm.h"
+#include "ac_darwin_drm.h"
+#include "util/u_sync_provider.h"
+
+struct acd_syncobj {
+   bool in_use;
+   bool binary_signaled;  /* binary payload */
+   uint64_t point;        /* highest signalled timeline point */
+};
+
+struct acd_sync {
+   struct util_sync_provider base;
+   pthread_mutex_t mtx;
+   pthread_cond_t cond;
+   struct acd_syncobj *objs;
+   uint32_t count;
+};
+
+static struct acd_sync *
+to_sync(struct util_sync_provider *p)
+{
+   return (struct acd_sync *)p;
+}
+
+static struct acd_syncobj *
+lookup(struct acd_sync *s, uint32_t handle)
+{
+   if (handle == 0 || handle > s->count || !s->objs[handle - 1].in_use)
+      return NULL;
+   return &s->objs[handle - 1];
+}
+
+static int
+sync_create(struct util_sync_provider *p, uint32_t flags, uint32_t *handle)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   uint32_t i;
+   for (i = 0; i < s->count && s->objs[i].in_use; i++)
+      ;
+   if (i == s->count) {
+      struct acd_syncobj *n = realloc(s->objs, (s->count + 16) * sizeof(*n));
+      if (!n) {
+         pthread_mutex_unlock(&s->mtx);
+         return -ENOMEM;
+      }
+      memset(n + s->count, 0, 16 * sizeof(*n));
+      s->objs = n;
+      s->count += 16;
+   }
+   s->objs[i] = (struct acd_syncobj){.in_use = true, .binary_signaled = !!(flags & DRM_SYNCOBJ_CREATE_SIGNALED)};
+   *handle = i + 1;
+   pthread_mutex_unlock(&s->mtx);
+   return 0;
+}
+
+static int
+sync_destroy(struct util_sync_provider *p, uint32_t handle)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   struct acd_syncobj *o = lookup(s, handle);
+   if (o)
+      o->in_use = false;
+   pthread_mutex_unlock(&s->mtx);
+   return o ? 0 : -EINVAL;
+}
+
+static int
+sync_handle_to_fd(struct util_sync_provider *p, uint32_t handle, int *out_obj_fd)
+{
+   return -ENOSYS;
+}
+
+static int
+sync_fd_to_handle(struct util_sync_provider *p, int obj_fd, uint32_t *handle)
+{
+   return -ENOSYS;
+}
+
+static int
+sync_import_sync_file(struct util_sync_provider *p, uint32_t handle, int sync_file_fd)
+{
+   return -ENOSYS;
+}
+
+static int
+sync_export_sync_file(struct util_sync_provider *p, uint32_t handle, int *out_sync_file_fd)
+{
+   return -ENOSYS;
+}
+
+static bool
+point_done(const struct acd_syncobj *o, uint64_t point)
+{
+   /* point 0 on a timeline wait means the binary payload */
+   return point ? o->point >= point : o->binary_signaled;
+}
+
+/* timeout_nsec is an absolute CLOCK_MONOTONIC time, as in the DRM ioctls. */
+static int
+wait_locked(struct acd_sync *s, uint32_t *handles, const uint64_t *points, unsigned n, int64_t timeout_nsec,
+            unsigned flags, uint32_t *first_signaled)
+{
+   struct timespec now_m, now_r;
+   clock_gettime(CLOCK_MONOTONIC, &now_m);
+   clock_gettime(CLOCK_REALTIME, &now_r);
+   const bool infinite = timeout_nsec == INT64_MAX;
+   int64_t rel = infinite ? INT64_MAX : timeout_nsec - ((int64_t)now_m.tv_sec * 1000000000ll + now_m.tv_nsec);
+   struct timespec deadline;
+   int64_t dl = (int64_t)now_r.tv_sec * 1000000000ll + now_r.tv_nsec + (infinite ? 0 : rel > 0 ? rel : 0);
+   deadline.tv_sec = dl / 1000000000ll;
+   deadline.tv_nsec = dl % 1000000000ll;
+
+   for (;;) {
+      unsigned done = 0;
+      int first = -1;
+      for (unsigned i = 0; i < n; i++) {
+         struct acd_syncobj *o = lookup(s, handles[i]);
+         if (!o)
+            return -EINVAL;
+         if (point_done(o, points ? points[i] : 0)) {
+            done++;
+            if (first < 0)
+               first = i;
+         }
+      }
+      bool ok = (flags & DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL) ? done == n : done > 0;
+      if (ok) {
+         if (first_signaled)
+            *first_signaled = first < 0 ? 0 : first;
+         return 0;
+      }
+      if (rel <= 0)
+         return -ETIME;
+      if (infinite)
+         pthread_cond_wait(&s->cond, &s->mtx);
+      else if (pthread_cond_timedwait(&s->cond, &s->mtx, &deadline) == ETIMEDOUT)
+         rel = 0; /* evaluate the state one last time, then -ETIME */
+   }
+}
+
+static int
+sync_wait(struct util_sync_provider *p, uint32_t *handles, unsigned num_handles, int64_t timeout_nsec,
+          unsigned flags, uint32_t *first_signaled)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   int r = wait_locked(s, handles, NULL, num_handles, timeout_nsec, flags, first_signaled);
+   pthread_mutex_unlock(&s->mtx);
+   return r;
+}
+
+static int
+sync_timeline_wait(struct util_sync_provider *p, uint32_t *handles, uint64_t *points, unsigned num_handles,
+                   int64_t timeout_nsec, unsigned flags, uint32_t *first_signaled)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   int r = wait_locked(s, handles, points, num_handles, timeout_nsec, flags, first_signaled);
+   pthread_mutex_unlock(&s->mtx);
+   return r;
+}
+
+static int
+sync_reset(struct util_sync_provider *p, const uint32_t *handles, uint32_t handle_count)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   for (uint32_t i = 0; i < handle_count; i++) {
+      struct acd_syncobj *o = lookup(s, handles[i]);
+      if (!o) {
+         pthread_mutex_unlock(&s->mtx);
+         return -EINVAL;
+      }
+      o->binary_signaled = false;
+   }
+   pthread_mutex_unlock(&s->mtx);
+   return 0;
+}
+
+static int
+sync_signal(struct util_sync_provider *p, const uint32_t *handles, uint32_t handle_count)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   for (uint32_t i = 0; i < handle_count; i++) {
+      struct acd_syncobj *o = lookup(s, handles[i]);
+      if (!o) {
+         pthread_mutex_unlock(&s->mtx);
+         return -EINVAL;
+      }
+      o->binary_signaled = true;
+   }
+   pthread_cond_broadcast(&s->cond);
+   pthread_mutex_unlock(&s->mtx);
+   return 0;
+}
+
+static int
+sync_timeline_signal(struct util_sync_provider *p, const uint32_t *handles, uint64_t *points,
+                     uint32_t handle_count)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   for (uint32_t i = 0; i < handle_count; i++) {
+      struct acd_syncobj *o = lookup(s, handles[i]);
+      if (!o) {
+         pthread_mutex_unlock(&s->mtx);
+         return -EINVAL;
+      }
+      if (points[i] > o->point)
+         o->point = points[i];
+   }
+   pthread_cond_broadcast(&s->cond);
+   pthread_mutex_unlock(&s->mtx);
+   return 0;
+}
+
+static int
+sync_query(struct util_sync_provider *p, uint32_t *handles, uint64_t *points, uint32_t handle_count,
+           uint32_t flags)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   for (uint32_t i = 0; i < handle_count; i++) {
+      struct acd_syncobj *o = lookup(s, handles[i]);
+      if (!o) {
+         pthread_mutex_unlock(&s->mtx);
+         return -EINVAL;
+      }
+      points[i] = o->point;
+   }
+   pthread_mutex_unlock(&s->mtx);
+   return 0;
+}
+
+static int
+sync_transfer(struct util_sync_provider *p, uint32_t dst_handle, uint64_t dst_point, uint32_t src_handle,
+              uint64_t src_point, uint32_t flags)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_mutex_lock(&s->mtx);
+   struct acd_syncobj *dst = lookup(s, dst_handle);
+   struct acd_syncobj *src = lookup(s, src_handle);
+   if (!dst || !src) {
+      pthread_mutex_unlock(&s->mtx);
+      return -EINVAL;
+   }
+   /* Only already-signalled sources can be transferred until the kext gives
+    * us pending fences (S1c). */
+   if (!point_done(src, src_point)) {
+      pthread_mutex_unlock(&s->mtx);
+      return -EINVAL;
+   }
+   if (dst_point) {
+      if (dst_point > dst->point)
+         dst->point = dst_point;
+   } else {
+      dst->binary_signaled = true;
+   }
+   pthread_cond_broadcast(&s->cond);
+   pthread_mutex_unlock(&s->mtx);
+   return 0;
+}
+
+static void
+sync_finalize(struct util_sync_provider *p)
+{
+   struct acd_sync *s = to_sync(p);
+   pthread_cond_destroy(&s->cond);
+   pthread_mutex_destroy(&s->mtx);
+   free(s->objs);
+   free(s);
+}
+
+static struct util_sync_provider *
+sync_clone(struct util_sync_provider *p)
+{
+   /* A clone must share the handle space; not needed by RADV in S1. */
+   return NULL;
+}
+
+struct util_sync_provider *
+acd_sync_provider_create(void)
+{
+   struct acd_sync *s = calloc(1, sizeof(*s));
+   if (!s)
+      return NULL;
+   pthread_mutex_init(&s->mtx, NULL);
+   pthread_cond_init(&s->cond, NULL);
+   s->base = (struct util_sync_provider){
+      .create = sync_create,
+      .destroy = sync_destroy,
+      .handle_to_fd = sync_handle_to_fd,
+      .fd_to_handle = sync_fd_to_handle,
+      .import_sync_file = sync_import_sync_file,
+      .export_sync_file = sync_export_sync_file,
+      .wait = sync_wait,
+      .reset = sync_reset,
+      .signal = sync_signal,
+      .timeline_signal = sync_timeline_signal,
+      .timeline_wait = sync_timeline_wait,
+      .query = sync_query,
+      .transfer = sync_transfer,
+      .finalize = sync_finalize,
+      .clone = sync_clone,
+   };
+   return &s->base;
+}
diff --git a/src/amd/common/darwin/amdgpu_vamgr.c b/src/amd/common/darwin/amdgpu_vamgr.c
new file mode 100644
index 00000000000..108a7673980
--- /dev/null
+++ b/src/amd/common/darwin/amdgpu_vamgr.c
@@ -0,0 +1,383 @@
+/*
+ * libdrm's amdgpu_vamgr.c (MIT), vendored for RADV on macOS with the two
+ * amdgpu_device based entry points removed.  Upstream: libdrm b97cbde,
+ * amdgpu/amdgpu_vamgr.c.  See ac_darwin_drm.h.
+ */
+/*
+ * Copyright 2014 Advanced Micro Devices, Inc.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE COPYRIGHT HOLDER(S) OR AUTHOR(S) BE LIABLE FOR ANY CLAIM, DAMAGES OR
+ * OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,
+ * ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
+ * OTHER DEALINGS IN THE SOFTWARE.
+ *
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include "amdgpu.h"
+#include "drm-uapi/amdgpu_drm.h"
+#include "amdgpu_vamgr_internal.h"
+
+drm_private void amdgpu_vamgr_init(struct amdgpu_bo_va_mgr *mgr, uint64_t start,
+				   uint64_t max, uint64_t alignment)
+{
+	struct amdgpu_bo_va_hole *n;
+
+	mgr->va_max = max;
+	mgr->va_alignment = alignment;
+
+	list_inithead(&mgr->va_holes);
+	pthread_mutex_init(&mgr->bo_va_mutex, NULL);
+	pthread_mutex_lock(&mgr->bo_va_mutex);
+	n = calloc(1, sizeof(struct amdgpu_bo_va_hole));
+	n->size = mgr->va_max - start;
+	n->offset = start;
+	list_add(&n->list, &mgr->va_holes);
+	pthread_mutex_unlock(&mgr->bo_va_mutex);
+}
+
+drm_private void amdgpu_vamgr_deinit(struct amdgpu_bo_va_mgr *mgr)
+{
+	struct amdgpu_bo_va_hole *hole, *tmp;
+	LIST_FOR_EACH_ENTRY_SAFE(hole, tmp, &mgr->va_holes, list) {
+		list_del(&hole->list);
+		free(hole);
+	}
+	pthread_mutex_destroy(&mgr->bo_va_mutex);
+}
+
+static drm_private int
+amdgpu_vamgr_subtract_hole(struct amdgpu_bo_va_hole *hole, uint64_t start_va,
+			   uint64_t end_va)
+{
+	if (start_va > hole->offset && end_va - hole->offset < hole->size) {
+		struct amdgpu_bo_va_hole *n = calloc(1, sizeof(struct amdgpu_bo_va_hole));
+		if (!n)
+			return -ENOMEM;
+
+		n->size = start_va - hole->offset;
+		n->offset = hole->offset;
+		list_add(&n->list, &hole->list);
+
+		hole->size -= (end_va - hole->offset);
+		hole->offset = end_va;
+	} else if (start_va > hole->offset) {
+		hole->size = start_va - hole->offset;
+	} else if (end_va - hole->offset < hole->size) {
+		hole->size -= (end_va - hole->offset);
+		hole->offset = end_va;
+	} else {
+		list_del(&hole->list);
+		free(hole);
+	}
+
+	return 0;
+}
+
+static drm_private int
+amdgpu_vamgr_find_va(struct amdgpu_bo_va_mgr *mgr, uint64_t size,
+		     uint64_t alignment, uint64_t base_required,
+		     bool search_from_top, uint64_t *va_out)
+{
+	struct amdgpu_bo_va_hole *hole, *n;
+	uint64_t offset = 0;
+	int ret;
+
+
+	alignment = MAX2(alignment, mgr->va_alignment);
+	size = ALIGN(size, mgr->va_alignment);
+
+	if (base_required % alignment)
+		return -EINVAL;
+
+	pthread_mutex_lock(&mgr->bo_va_mutex);
+	if (!search_from_top) {
+		LIST_FOR_EACH_ENTRY_SAFE_REV(hole, n, &mgr->va_holes, list) {
+			if (base_required) {
+				if (hole->offset > base_required ||
+				   (hole->offset + hole->size) < (base_required + size))
+					continue;
+				offset = base_required;
+			} else {
+				uint64_t waste = hole->offset % alignment;
+				waste = waste ? alignment - waste : 0;
+				offset = hole->offset + waste;
+				if (offset >= (hole->offset + hole->size) ||
+				    size > (hole->offset + hole->size) - offset) {
+					continue;
+				}
+			}
+			ret = amdgpu_vamgr_subtract_hole(hole, offset, offset + size);
+			pthread_mutex_unlock(&mgr->bo_va_mutex);
+			*va_out = offset;
+			return ret;
+		}
+	} else {
+		LIST_FOR_EACH_ENTRY_SAFE(hole, n, &mgr->va_holes, list) {
+			if (base_required) {
+				if (hole->offset > base_required ||
+				   (hole->offset + hole->size) < (base_required + size))
+					continue;
+				offset = base_required;
+			} else {
+				if (size > hole->size)
+					continue;
+
+				offset = hole->offset + hole->size - size;
+				offset -= offset % alignment;
+				if (offset < hole->offset) {
+					continue;
+				}
+			}
+
+			ret = amdgpu_vamgr_subtract_hole(hole, offset, offset + size);
+			pthread_mutex_unlock(&mgr->bo_va_mutex);
+			*va_out = offset;
+			return ret;
+		}
+	}
+
+	pthread_mutex_unlock(&mgr->bo_va_mutex);
+	return -ENOMEM;
+}
+
+static drm_private void
+amdgpu_vamgr_free_va(struct amdgpu_bo_va_mgr *mgr, uint64_t va, uint64_t size)
+{
+	struct amdgpu_bo_va_hole *hole, *next;
+
+	if (va == AMDGPU_INVALID_VA_ADDRESS)
+		return;
+
+	size = ALIGN(size, mgr->va_alignment);
+
+	pthread_mutex_lock(&mgr->bo_va_mutex);
+	hole = libdrm_container_of(&mgr->va_holes, hole, list);
+	LIST_FOR_EACH_ENTRY(next, &mgr->va_holes, list) {
+		if (next->offset < va)
+			break;
+		hole = next;
+	}
+
+	if (&hole->list != &mgr->va_holes) {
+		/* Grow upper hole if it's adjacent */
+		if (hole->offset == (va + size)) {
+			hole->offset = va;
+			hole->size += size;
+			/* Merge lower hole if it's adjacent */
+			if (next != hole &&
+			    &next->list != &mgr->va_holes &&
+			    (next->offset + next->size) == va) {
+				next->size += hole->size;
+				list_del(&hole->list);
+				free(hole);
+			}
+			goto out;
+		}
+	}
+
+	/* Grow lower hole if it's adjacent */
+	if (next != hole && &next->list != &mgr->va_holes &&
+	    (next->offset + next->size) == va) {
+		next->size += size;
+		goto out;
+	}
+
+	/* FIXME on allocation failure we just lose virtual address space
+	 * maybe print a warning
+	 */
+	next = calloc(1, sizeof(struct amdgpu_bo_va_hole));
+	if (next) {
+		next->size = size;
+		next->offset = va;
+		list_add(&next->list, &hole->list);
+	}
+
+out:
+	pthread_mutex_unlock(&mgr->bo_va_mutex);
+}
+
+drm_public int amdgpu_va_range_alloc2(amdgpu_va_manager_handle va_mgr,
+				      enum amdgpu_gpu_va_range va_range_type,
+				      uint64_t size,
+				      uint64_t va_base_alignment,
+				      uint64_t va_base_required,
+				      uint64_t *va_base_allocated,
+				      amdgpu_va_handle *va_range_handle,
+				      uint64_t flags)
+{
+	struct amdgpu_bo_va_mgr *vamgr;
+	bool search_from_top = !!(flags & AMDGPU_VA_RANGE_REPLAYABLE);
+	int ret;
+
+	/* Clear the flag when the high VA manager is not initialized */
+	if (flags & AMDGPU_VA_RANGE_HIGH && !va_mgr->vamgr_high_32.va_max)
+		flags &= ~AMDGPU_VA_RANGE_HIGH;
+
+	if (flags & AMDGPU_VA_RANGE_HIGH) {
+		if (flags & AMDGPU_VA_RANGE_32_BIT)
+			vamgr = &va_mgr->vamgr_high_32;
+		else
+			vamgr = &va_mgr->vamgr_high;
+	} else {
+		if (flags & AMDGPU_VA_RANGE_32_BIT)
+			vamgr = &va_mgr->vamgr_32;
+		else
+			vamgr = &va_mgr->vamgr_low;
+	}
+
+	va_base_alignment = MAX2(va_base_alignment, vamgr->va_alignment);
+	size = ALIGN(size, vamgr->va_alignment);
+
+	ret = amdgpu_vamgr_find_va(vamgr, size,
+				   va_base_alignment, va_base_required,
+				   search_from_top, va_base_allocated);
+
+	if (!(flags & AMDGPU_VA_RANGE_32_BIT) && ret) {
+		/* fallback to 32bit address */
+		if (flags & AMDGPU_VA_RANGE_HIGH)
+			vamgr = &va_mgr->vamgr_high_32;
+		else
+			vamgr = &va_mgr->vamgr_32;
+		ret = amdgpu_vamgr_find_va(vamgr, size,
+					   va_base_alignment, va_base_required,
+					   search_from_top, va_base_allocated);
+	}
+
+	if (!ret) {
+		struct amdgpu_va* va;
+		va = calloc(1, sizeof(struct amdgpu_va));
+		if(!va){
+			amdgpu_vamgr_free_va(vamgr, *va_base_allocated, size);
+			return -ENOMEM;
+		}
+		va->address = *va_base_allocated;
+		va->size = size;
+		va->range = va_range_type;
+		va->vamgr = vamgr;
+		*va_range_handle = va;
+	}
+
+	return ret;
+}
+
+drm_public int amdgpu_va_range_free(amdgpu_va_handle va_range_handle)
+{
+	if(!va_range_handle || !va_range_handle->address)
+		return 0;
+
+	amdgpu_vamgr_free_va(va_range_handle->vamgr,
+			va_range_handle->address,
+			va_range_handle->size);
+	free(va_range_handle);
+	return 0;
+}
+
+drm_public uint64_t amdgpu_va_get_start_addr(amdgpu_va_handle va_handle)
+{
+   return va_handle->address;
+}
+
+drm_public amdgpu_va_manager_handle amdgpu_va_manager_alloc(void)
+{
+	amdgpu_va_manager_handle r = calloc(1, sizeof(struct amdgpu_va_manager));
+	return r;
+}
+
+drm_public void amdgpu_va_manager_init(struct amdgpu_va_manager *va_mgr,
+				       uint64_t low_va_offset, uint64_t low_va_max,
+				       uint64_t high_va_offset, uint64_t high_va_max,
+				       uint32_t virtual_address_alignment)
+{
+	amdgpu_va_manager_init2(va_mgr, low_va_offset, low_va_max,
+				high_va_offset, high_va_max,
+				virtual_address_alignment, 0);
+}
+
+drm_public void amdgpu_va_manager_init2(struct amdgpu_va_manager *va_mgr,
+					uint64_t low_va_offset, uint64_t low_va_max,
+					uint64_t high_va_offset, uint64_t high_va_max,
+					uint32_t virtual_address_alignment,
+					uint32_t flags)
+{
+	uint64_t start, max;
+
+	va_mgr->address_prt_wa_control_bit = ~0;
+
+	start = low_va_offset;
+	max = MIN2(low_va_max, 0x100000000ULL);
+	amdgpu_vamgr_init(&va_mgr->vamgr_32, start, max,
+			  virtual_address_alignment);
+
+	start = max;
+	if ((flags & AMDGPU_VA_MGR_RESERVE_HALF_VA_FOR_PRT) && !high_va_max) {
+		/* Reserve the half VA range for PRT by splitting it in two
+		 * equal halves where one bit controls whether it's the LOW or
+		 * HIGH half.
+		 */
+		va_mgr->address_prt_wa_control_bit = util_last_bit64(low_va_offset ^ low_va_max) - 1;
+		max = low_va_max ^ (1ull << va_mgr->address_prt_wa_control_bit);
+	} else {
+		max = MAX2(low_va_max, 0x100000000ULL);
+	}
+
+	amdgpu_vamgr_init(&va_mgr->vamgr_low, start, max,
+			  virtual_address_alignment);
+
+	start = high_va_offset;
+	max = MIN2(high_va_max, (start & ~0xffffffffULL) + 0x100000000ULL);
+	amdgpu_vamgr_init(&va_mgr->vamgr_high_32, start, max,
+			  virtual_address_alignment);
+
+	start = max;
+	if ((flags & AMDGPU_VA_MGR_RESERVE_HALF_VA_FOR_PRT) && high_va_max) {
+		/* Reserve the half VA range for PRT by splitting it in two
+		 * equal halves where one bit controls whether it's the LOW or
+		 * HIGH half.
+		 */
+		va_mgr->address_prt_wa_control_bit = util_last_bit64(high_va_offset ^ high_va_max) - 1;
+		max = high_va_max ^ (1ull << va_mgr->address_prt_wa_control_bit);
+	} else {
+		max = MAX2(high_va_max, (start & ~0xffffffffULL) + 0x100000000ULL);
+	}
+
+	amdgpu_vamgr_init(&va_mgr->vamgr_high, start, max,
+			  virtual_address_alignment);
+}
+
+drm_public void amdgpu_va_manager_deinit(struct amdgpu_va_manager *va_mgr)
+{
+	amdgpu_vamgr_deinit(&va_mgr->vamgr_32);
+	amdgpu_vamgr_deinit(&va_mgr->vamgr_low);
+	amdgpu_vamgr_deinit(&va_mgr->vamgr_high_32);
+	amdgpu_vamgr_deinit(&va_mgr->vamgr_high);
+}
+
+drm_public int amdgpu_va_manager_query_sw_info(struct amdgpu_va_manager *va_mgr,
+					       enum amdgpu_va_manager_sw_info info,
+					       void *value)
+{
+	uint32_t *val32 = (uint32_t*)value;
+
+	switch (info) {
+	case amdgpu_va_manager_sw_info_address_prt_wa_control_bit:
+		*val32 = va_mgr->address_prt_wa_control_bit;
+		return 0;
+	}
+	return -EINVAL;
+}
diff --git a/src/amd/common/darwin/amdgpu_vamgr_internal.h b/src/amd/common/darwin/amdgpu_vamgr_internal.h
new file mode 100644
index 00000000000..ca5c00115d7
--- /dev/null
+++ b/src/amd/common/darwin/amdgpu_vamgr_internal.h
@@ -0,0 +1,61 @@
+/*
+ * Subset of libdrm's amdgpu/amdgpu_internal.h (MIT) that the vendored VA
+ * manager needs.
+ */
+#ifndef AMDGPU_VAMGR_INTERNAL_H
+#define AMDGPU_VAMGR_INTERNAL_H
+
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+
+#include "amdgpu.h"
+#include "libdrm_util_double_list.h"
+#include "util/macros.h"
+#include "util/u_math.h"
+
+#define drm_private __attribute__((visibility("hidden")))
+#define drm_public  __attribute__((visibility("default")))
+
+#define __round_mask(x, y) ((__typeof__(x))((y)-1))
+#define ROUND_UP(x, y) ((((x)-1) | __round_mask(x, y))+1)
+#define ROUND_DOWN(x, y) ((x) & ~__round_mask(x, y))
+
+#define __align_mask(value, mask)  (((value) + (mask)) & ~(mask))
+#define ALIGN(value, alignment)    __align_mask(value, (__typeof__(value))((alignment) - 1))
+
+#define AMDGPU_INVALID_VA_ADDRESS	0xffffffffffffffff
+
+struct amdgpu_bo_va_hole {
+	struct list_head list;
+	uint64_t offset;
+	uint64_t size;
+};
+
+struct amdgpu_bo_va_mgr {
+	uint64_t va_max;
+	struct list_head va_holes;
+	pthread_mutex_t bo_va_mutex;
+	uint32_t va_alignment;
+};
+
+struct amdgpu_va {
+	uint64_t address;
+	uint64_t size;
+	enum amdgpu_gpu_va_range range;
+	struct amdgpu_bo_va_mgr *vamgr;
+};
+
+struct amdgpu_va_manager {
+	struct amdgpu_bo_va_mgr vamgr_low;
+	struct amdgpu_bo_va_mgr vamgr_32;
+	struct amdgpu_bo_va_mgr vamgr_high;
+	struct amdgpu_bo_va_mgr vamgr_high_32;
+	unsigned address_prt_wa_control_bit;
+};
+
+drm_private void amdgpu_vamgr_init(struct amdgpu_bo_va_mgr *mgr, uint64_t start,
+		       uint64_t max, uint64_t alignment);
+drm_private void amdgpu_vamgr_deinit(struct amdgpu_bo_va_mgr *mgr);
+
+#endif
diff --git a/src/amd/common/darwin/libdrm_util_double_list.h b/src/amd/common/darwin/libdrm_util_double_list.h
new file mode 100644
index 00000000000..5348628db30
--- /dev/null
+++ b/src/amd/common/darwin/libdrm_util_double_list.h
@@ -0,0 +1,121 @@
+/*
+ * SPDX-FileCopyrightText: 2006 Tungsten Graphics, Inc., Bismarck, ND. USA.
+ * SPDX-License-Identifier: MIT
+ */
+
+/**
+ * \file
+ * List macros heavily inspired by the Linux kernel
+ * list handling. No list looping yet.
+ *
+ * Is not threadsafe, so common operations need to
+ * be protected using an external mutex.
+ */
+#ifndef _U_DOUBLE_LIST_H_
+#define _U_DOUBLE_LIST_H_
+
+#include <stddef.h>
+
+struct list_head
+{
+    struct list_head *prev;
+    struct list_head *next;
+};
+
+static inline void list_inithead(struct list_head *item)
+{
+    item->prev = item;
+    item->next = item;
+}
+
+static inline void list_add(struct list_head *item, struct list_head *list)
+{
+    item->prev = list;
+    item->next = list->next;
+    list->next->prev = item;
+    list->next = item;
+}
+
+static inline void list_addtail(struct list_head *item, struct list_head *list)
+{
+    item->next = list;
+    item->prev = list->prev;
+    list->prev->next = item;
+    list->prev = item;
+}
+
+static inline void list_replace(struct list_head *from, struct list_head *to)
+{
+    to->prev = from->prev;
+    to->next = from->next;
+    from->next->prev = to;
+    from->prev->next = to;
+}
+
+static inline void list_del(struct list_head *item)
+{
+    item->prev->next = item->next;
+    item->next->prev = item->prev;
+}
+
+static inline void list_delinit(struct list_head *item)
+{
+    item->prev->next = item->next;
+    item->next->prev = item->prev;
+    item->next = item;
+    item->prev = item;
+}
+
+#define LIST_INITHEAD(__item) list_inithead(__item)
+#define LIST_ADD(__item, __list) list_add(__item, __list)
+#define LIST_ADDTAIL(__item, __list) list_addtail(__item, __list)
+#define LIST_REPLACE(__from, __to) list_replace(__from, __to)
+#define LIST_DEL(__item) list_del(__item)
+#define LIST_DELINIT(__item) list_delinit(__item)
+
+#define LIST_ENTRY(__type, __item, __field)   \
+    ((__type *)(((char *)(__item)) - offsetof(__type, __field)))
+
+#define LIST_FIRST_ENTRY(__ptr, __type, __field)   \
+    LIST_ENTRY(__type, (__ptr)->next, __field)
+
+#define LIST_LAST_ENTRY(__ptr, __type, __field)   \
+    LIST_ENTRY(__type, (__ptr)->prev, __field)
+
+#define LIST_IS_EMPTY(__list)                   \
+    ((__list)->next == (__list))
+
+#ifndef libdrm_container_of /* Mesa util/macros.h has a different container_of */
+#define libdrm_container_of(ptr, sample, member)				\
+    (void *)((char *)(ptr)						\
+	     - ((char *)&((__typeof__(sample))0)->member))
+#endif
+
+#define LIST_FOR_EACH_ENTRY(pos, head, member)				\
+   for (pos = libdrm_container_of((head)->next, pos, member);			\
+	&pos->member != (head);						\
+	pos = libdrm_container_of(pos->member.next, pos, member))
+
+#define LIST_FOR_EACH_ENTRY_SAFE(pos, storage, head, member)	\
+   for (pos = libdrm_container_of((head)->next, pos, member),			\
+	storage = libdrm_container_of(pos->member.next, pos, member);	\
+	&pos->member != (head);						\
+	pos = storage, storage = libdrm_container_of(storage->member.next, storage, member))
+
+#define LIST_FOR_EACH_ENTRY_SAFE_REV(pos, storage, head, member)	\
+   for (pos = libdrm_container_of((head)->prev, pos, member),			\
+	storage = libdrm_container_of(pos->member.prev, pos, member);		\
+	&pos->member != (head);						\
+	pos = storage, storage = libdrm_container_of(storage->member.prev, storage, member))
+
+#define LIST_FOR_EACH_ENTRY_FROM(pos, start, head, member)		\
+   for (pos = libdrm_container_of((start), pos, member);			\
+	&pos->member != (head);						\
+	pos = libdrm_container_of(pos->member.next, pos, member))
+
+#define LIST_FOR_EACH_ENTRY_FROM_REV(pos, start, head, member)		\
+   for (pos = libdrm_container_of((start), pos, member);			\
+	&pos->member != (head);						\
+	pos = libdrm_container_of(pos->member.prev, pos, member))
+
+#endif /*_U_DOUBLE_LIST_H_*/
