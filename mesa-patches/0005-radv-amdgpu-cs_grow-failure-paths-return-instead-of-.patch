From 6ed3cdc10c15e683c2b43c5436e0ebf60216cebb Mon Sep 17 00:00:00 2001
From: Navi48-MacOS contributors <noreply@example.invalid>
Date: Thu, 1 Jan 2026 00:00:00 +0000
Subject: [PATCH 5/5] radv/amdgpu: cs_grow failure paths return instead of
 writing before the IB (Navi48 P1)

An IB allocation or map failure fell through into the chain_ib writes at
buf[cdw - 4] with cdw = 0 (WindowServer SEGV at ...fff0 on an earlier run).
Both paths now return with the stream in error, emitting into the old IB or
a host scratch buffer that reset restores.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c | 54 +++++++++++++++++--
 1 file changed, 51 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
index 2aa297bcdb9..430ad0ac7ff 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
@@ -77,6 +77,13 @@ struct radv_amdgpu_cs {
    unsigned hw_ip;
 
    struct hash_table *annotations;
+
+   /* Navi48: host scratch the stream emits into after an IB allocation failure when the failed request does not fit in
+    * the current IB (see radv_amdgpu_cs_error_space). err_saved_* is the IB mapping to go back to at reset. */
+   uint32_t *err_buf;
+   size_t err_dw;
+   uint32_t *err_saved_buf;
+   uint32_t err_saved_max_dw;
 };
 
 struct radv_winsys_sem_counts {
@@ -186,6 +193,7 @@ radv_amdgpu_cs_destroy(struct ac_cmdbuf *rcs)
 
    free(cs->ib_buffers);
    free(cs->handles);
+   free(cs->err_buf);
    free(cs);
 }
 
@@ -394,16 +402,46 @@ radv_amdgpu_restore_last_ib(struct radv_amdgpu_cs *cs)
    cs->ib_buffer = ib->bo;
 }
 
+/* Navi48: the stream is dead (cs->status != VK_SUCCESS) but the callers of cs_grow still emit up to min_size dwords
+ * starting at cdw = 0 once it returns (radeon_check_space), and with chain_ib the old code also wrote
+ * buf[cdw - 4] with cdw = 0, i.e. 16 bytes before the buffer. Keep every such write inside memory we own: the current IB
+ * if it can hold min_size dwords, else a host scratch buffer. vkEndCommandBuffer reports the error status. */
+static void
+radv_amdgpu_cs_error_space(struct radv_amdgpu_cs *cs, size_t min_size)
+{
+   cs->base.cdw = 0;
+   if (min_size <= cs->base.max_dw)
+      return;
+
+   const size_t dw = min_size + 16;
+   if (dw > cs->err_dw) {
+      uint32_t *buf = realloc(cs->err_buf, dw * sizeof(uint32_t));
+      if (!buf)
+         return; /* host OOM as well: nothing left to point at (only reachable when min_size exceeds the whole IB) */
+      cs->err_buf = buf;
+      cs->err_dw = dw;
+   }
+   if (!cs->err_saved_buf) {
+      cs->err_saved_buf = cs->base.buf;
+      cs->err_saved_max_dw = cs->base.max_dw;
+   }
+   cs->base.buf = cs->err_buf;
+   cs->base.max_dw = cs->err_dw - 4;
+}
+
 static void
 radv_amdgpu_cs_grow(struct ac_cmdbuf *_cs, size_t min_size)
 {
    struct radv_amdgpu_cs *cs = radv_amdgpu_cs(_cs);
 
    if (cs->status != VK_SUCCESS) {
-      cs->base.cdw = 0;
+      radv_amdgpu_cs_error_space(cs, min_size);
       return;
    }
 
+   /* The map below overwrites ib_mapped; the failure paths go back to the IB that cs_finalize just closed. */
+   uint8_t *const prev_ib_mapped = cs->ib_mapped;
+
    const uint32_t ib_alignment = cs->ws->info.ip[cs->hw_ip].ib_alignment;
 
    cs->ws->base.cs_finalize(_cs);
@@ -415,19 +453,23 @@ radv_amdgpu_cs_grow(struct ac_cmdbuf *_cs, size_t min_size)
    VkResult result = radv_amdgpu_cs_bo_create(cs, ib_size);
 
    if (result != VK_SUCCESS) {
-      cs->base.cdw = 0;
       cs->status = VK_ERROR_OUT_OF_DEVICE_MEMORY;
       radv_amdgpu_restore_last_ib(cs);
+      cs->ib_mapped = prev_ib_mapped;
+      radv_amdgpu_cs_error_space(cs, min_size);
+      return; /* Navi48: was a fall-through into the chain_ib writes at buf[cdw - 4] with cdw = 0 */
    }
 
    cs->ib_mapped = radv_buffer_map(&cs->ws->base, cs->ib_buffer);
    if (!cs->ib_mapped) {
       cs->ws->base.buffer_destroy(&cs->ws->base, cs->ib_buffer);
-      cs->base.cdw = 0;
 
       /* VK_ERROR_MEMORY_MAP_FAILED is not valid for vkEndCommandBuffer. */
       cs->status = VK_ERROR_OUT_OF_DEVICE_MEMORY;
       radv_amdgpu_restore_last_ib(cs);
+      cs->ib_mapped = prev_ib_mapped;
+      radv_amdgpu_cs_error_space(cs, min_size);
+      return; /* Navi48: ib_mapped was NULL here and buf was then set to it */
    }
 
    cs->ws->base.cs_add_buffer(&cs->base, cs->ib_buffer);
@@ -517,6 +559,12 @@ radv_amdgpu_cs_reset(struct ac_cmdbuf *_cs)
    cs->base.reserved_dw = 0;
    cs->status = VK_SUCCESS;
 
+   if (cs->err_saved_buf) { /* Navi48: leave the error scratch buffer (see radv_amdgpu_cs_error_space) */
+      cs->base.buf = cs->err_saved_buf;
+      cs->base.max_dw = cs->err_saved_max_dw;
+      cs->err_saved_buf = NULL;
+   }
+
    for (unsigned i = 0; i < cs->num_buffers; ++i) {
       unsigned hash = cs->handles[i].bo_handle & (ARRAY_SIZE(cs->buffer_hash_table) - 1);
       cs->buffer_hash_table[hash] = -1;
