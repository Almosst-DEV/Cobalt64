+
+/* ---- ABI 1.1 scanout ---- */
+
+int
+acd_kext_scan_query(struct acd_kext *k, struct n48n_scan_query *q)
+{
+   size_t sz = sizeof(*q);
+   memset(q, 0, sizeof(*q));
+   int r = kcall(k, ACD_SEL_SCAN_QUERY, NULL, 0, NULL, 0, NULL, NULL, q, &sz);
+   return r ? r : (sz == sizeof(*q) ? 0 : -EIO);
+}
+
+int
+acd_kext_scan_acquire(struct acd_kext *k, uint64_t *console_mc, uint64_t *frame_count)
+{
+   const uint64_t sin[1] = {0};
+   uint64_t sout[2] = {0};
+   uint32_t nout = 2;
+   int r = kcall(k, ACD_SEL_SCAN_ACQUIRE, sin, 1, NULL, 0, sout, &nout, NULL, NULL);
+   if (r)
+      return r;
+   *console_mc = sout[0];
+   *frame_count = sout[1];
+   return nout == 2 ? 0 : -EIO;
+}
+
+int
+acd_kext_scan_register(struct acd_kext *k, const struct n48n_scan_reg *reg, uint32_t *slot, uint64_t *mc)
+{
+   uint64_t sout[2] = {0};
+   uint32_t nout = 2;
+   acd_sfence();
+   int r = kcall(k, ACD_SEL_SCAN_REGISTER, NULL, 0, reg, sizeof(*reg), sout, &nout, NULL, NULL);
+   if (r)
+      return r;
+   *slot = (uint32_t)sout[0];
+   *mc = sout[1];
+   return nout == 2 ? 0 : -EIO;
+}
+
+int
+acd_kext_scan_present(struct acd_kext *k, uint32_t slot, uint64_t out[3])
+{
+   const uint64_t sin[2] = {slot, 0};
+   uint32_t nout = 3;
+   acd_sfence(); /* CPU-written (WC) scanout pixels must be visible before the flip */
+   int r = kcall(k, ACD_SEL_SCAN_PRESENT, sin, 2, NULL, 0, out, &nout, NULL, NULL);
+   return r ? r : (nout == 3 ? 0 : -EIO);
+}
+
+int
+acd_kext_scan_status(struct acd_kext *k, struct n48n_scan_status *st)
+{
+   size_t sz = sizeof(*st);
+   memset(st, 0, sizeof(*st));
+   int r = kcall(k, ACD_SEL_SCAN_STATUS, NULL, 0, NULL, 0, NULL, NULL, st, &sz);
+   return r ? r : (sz == sizeof(*st) ? 0 : -EIO);
+}
+
+int
+acd_kext_scan_release(struct acd_kext *k, uint64_t out[2])
+{
+   uint32_t nout = 2;
+   int r = kcall(k, ACD_SEL_SCAN_RELEASE, NULL, 0, NULL, 0, out, &nout, NULL, NULL);
+   return r ? r : (nout == 2 ? 0 : -EIO);
+}
