+/* ---- scanout model ---- */
+#define MOCK_SCAN_W 2560u
+#define MOCK_SCAN_H 1440u
+#define MOCK_SCAN_PITCH_PX 2560u
+#define MOCK_SCAN_HZ 60ull
+
+static uint64_t
+scan_frame_now(struct mock *m)
+{
+   return (mnow() - m->t0_ns) * MOCK_SCAN_HZ / 1000000000ull;
+}
+
+/* Advance the model to the current frame: every frame boundary is one VUPDATE; a pending flip latches at
+ * the first one after its program, later ones with nothing pending are repeats of the front. */
+static void
+scan_advance(struct mock *m)
+{
+   if (!m->scan_acq)
+      return;
+   const uint64_t f = scan_frame_now(m);
+   if (f <= m->scan_synced_frame)
+      return;
+   uint64_t vu = f - m->scan_synced_frame;
+   m->s_vupdates += vu;
+   if (m->pending >= 0 && f > m->pending_frame) {
+      /* one of the vupdates latched the pending flip (the first after program) */
+      const int p = m->pending;
+      m->sslot[p].latched_frame = m->pending_frame + 1;
+      m->sslot[p].latches++;
+      m->s_latched++;
+      if (!m->first_latch_ns)
+         m->first_latch_ns = mnow();
+      m->last_latch_ns = mnow();
+      m->front = p;
+      m->pending = -1;
+      vu -= 1;
