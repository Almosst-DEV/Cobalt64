+
+#include "radv_darwin_scanout.h"
+
+#include <errno.h>
+
+#include "common/darwin/ac_darwin_kext.h"
+#include "radv_amdgpu_bo.h"
+#include "radv_amdgpu_winsys.h"
+#include "radv_device.h"
+#include "radv_device_memory.h"
+
+struct acd_kext *ac_drm_darwin_kext(ac_drm_device *dev, uint32_t *abi_minor);
+
+#define API __attribute__((visibility("default")))
+
+static struct acd_kext *
+scan_kext(VkDevice _dev)
+{
+   VK_FROM_HANDLE(radv_device, device, _dev);
+   if (!device)
+      return NULL;
+   uint32_t minor = 0;
+   struct acd_kext *k = ac_drm_darwin_kext(radv_amdgpu_winsys(device->ws)->dev, &minor);
+   return (k && minor >= 1) ? k : NULL;
+}
+
+API int
+radv_darwin_scanout_query(VkDevice dev, struct n48n_scan_query *q)
+{
+   struct acd_kext *k = scan_kext(dev);
+   return k ? acd_kext_scan_query(k, q) : -ENOSYS;
+}
+
+API int
+radv_darwin_scanout_acquire(VkDevice dev, uint64_t *console_mc, uint64_t *frame_count)
+{
+   struct acd_kext *k = scan_kext(dev);
+   if (!k)
+      return -ENOSYS;
+   uint64_t c = 0, f = 0;
+   int r = acd_kext_scan_acquire(k, &c, &f);
+   if (!r) {
+      if (console_mc)
+         *console_mc = c;
+      if (frame_count)
+         *frame_count = f;
+   }
+   return r;
+}
+
+API int
+radv_darwin_scanout_register(VkDevice _dev, VkDeviceMemory _mem, uint64_t offset, uint32_t pitch_bytes,
+                             uint32_t width, uint32_t height, uint32_t *slot, uint64_t *slot_mc)
+{
+   struct acd_kext *k = scan_kext(_dev);
+   if (!k)
+      return -ENOSYS;
+   VK_FROM_HANDLE(radv_device_memory, mem, _mem);
+   if (!mem || !mem->bo)
+      return -EINVAL;
+   const struct n48n_scan_reg reg = {
+      .handle = radv_amdgpu_winsys_bo(mem->bo)->bo_handle,
+      .offset = offset,
+      .pitch_bytes = pitch_bytes,
+      .height = height,
+      .width = width,
+      .format = N48N_SCAN_FMT_ARGB8888,
+   };
+   uint32_t s = 0;
+   uint64_t mc = 0;
+   int r = acd_kext_scan_register(k, &reg, &s, &mc);
+   if (!r) {
+      if (slot)
+         *slot = s;
+      if (slot_mc)
+         *slot_mc = mc;
+   }
+   return r;
+}
+
+API int
+radv_darwin_scanout_present(VkDevice dev, uint32_t slot, uint64_t out[3])
+{
+   struct acd_kext *k = scan_kext(dev);
+   if (!k)
+      return -ENOSYS;
+   uint64_t o[3] = {0};
+   int r = acd_kext_scan_present(k, slot, o);
+   if (!r && out)
+      for (int i = 0; i < 3; i++)
+         out[i] = o[i];
+   return r;
+}
+
+API int
+radv_darwin_scanout_status(VkDevice dev, struct n48n_scan_status *st)
+{
+   struct acd_kext *k = scan_kext(dev);
+   return k ? acd_kext_scan_status(k, st) : -ENOSYS;
+}
+
+API int
+radv_darwin_scanout_release(VkDevice dev, uint64_t out[2])
+{
+   struct acd_kext *k = scan_kext(dev);
+   if (!k)
+      return -ENOSYS;
+   uint64_t o[2] = {0};
+   int r = acd_kext_scan_release(k, o);
+   if (!r && out) {
+      out[0] = o[0];
+      out[1] = o[1];
+   }
+   return r;
+}
