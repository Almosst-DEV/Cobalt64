--- /dev/null
+++ b/src/amd/vulkan/winsys/amdgpu/radv_darwin_scanout.h
@@ -0,0 +1,38 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Darwin-only C API exported by libvulkan_radeon.dylib for native scanout (kext ABI 1.1, selectors 9..14).
+ * Present goes through the SAME per-process N48N connection the Darwin winsys owns (decision D-S2-1).
+ * Look the functions up with dlsym on the ICD library.  All return 0 or -errno
+ * (-ENOSYS: not a native kext / ABI minor < 1; -EINVAL: VkDeviceMemory has no BO handle).
+ * The structs are those of navi48_native_abi.h.
+ */
+#ifndef RADV_DARWIN_SCANOUT_H
+#define RADV_DARWIN_SCANOUT_H
+
+#include <vulkan/vulkan.h>
+#include "navi48_native_abi.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Live plane geometry (valid before acquire). */
+int radv_darwin_scanout_query(VkDevice dev, struct n48n_scan_query *q);
+/* Takes the plane. *console_mc and *frame_count may be NULL. Second call: -EBUSY. */
+int radv_darwin_scanout_acquire(VkDevice dev, uint64_t *console_mc, uint64_t *frame_count);
+/* Registers `mem` (must be visible-pool VRAM: a HOST_VISIBLE|DEVICE_LOCAL allocation) at byte `offset` as a scanout buffer.
+ * width/height/pitch_bytes must equal the live plane (query: plane_w, plane_h, pitch_px*4); format is ARGB8888/B8G8R8A8. */
+int radv_darwin_scanout_register(VkDevice dev, VkDeviceMemory mem, uint64_t offset, uint32_t pitch_bytes,
+                                 uint32_t width, uint32_t height, uint32_t *slot, uint64_t *slot_mc);
+/* out[0] present id, [1] target frame, [2] VUPDATE count at program (out may be NULL). */
+int radv_darwin_scanout_present(VkDevice dev, uint32_t slot, uint64_t out[3]);
+int radv_darwin_scanout_status(VkDevice dev, struct n48n_scan_status *st);
+/* Restores the console; out[0] = restore verified, [1] plane MC after (out may be NULL). Idempotent. */
+int radv_darwin_scanout_release(VkDevice dev, uint64_t out[2]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
