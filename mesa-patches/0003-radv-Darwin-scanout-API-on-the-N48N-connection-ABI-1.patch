+   /* First ask for the minor (ABI 1.1, flags bit 8); a v1.0 kernel refuses unknown flags with
+    * BadArgument, which is the probe: retry plain. */
+   for (int with_minor = 1; with_minor >= 0; with_minor--) {
+      const uint64_t sin[2] = {N48N_ABI_VERSION, with_minor ? N48N_HELLO_F_MINOR : 0};
+      uint64_t sout[4] = {0};
