diff --git a/src/amd/common/darwin/ac_darwin_iokit.c b/src/amd/common/darwin/ac_darwin_iokit.c
new file mode 100644
index 00000000000..7e81081e530
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_iokit.c
@@ -0,0 +1,112 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * IOKit transport of the native kext ABI: IOServiceOpen of class Navi48Bringup
+ * with user-client type 'N48N' (NATIVE-S1C-ABI.md section 1).
+ */
+
+#include "ac_darwin_kext.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+
+struct iokit_ctx {
+   io_connect_t conn;
+};
+
+static int
+iokit_call(void *ctx, uint32_t sel, const uint64_t *sin, uint32_t nsin, const void *stin, size_t stinsz,
+           uint64_t *sout, uint32_t *nsout, void *stout, size_t *stoutsz)
+{
+   struct iokit_ctx *c = ctx;
+   uint32_t cnt = nsout ? *nsout : 0;
+   size_t osz = stoutsz ? *stoutsz : 0;
+   kern_return_t kr = IOConnectCallMethod(c->conn, sel, sin, nsin, stin, stinsz, sout, nsout ? &cnt : NULL,
+                                          stout, stoutsz ? &osz : NULL);
+   if (nsout)
+      *nsout = cnt;
+   if (stoutsz)
+      *stoutsz = osz;
+   return (int)kr;
+}
+
+static int
+iokit_map(void *ctx, uint32_t handle, void **addr, size_t *size)
+{
+   struct iokit_ctx *c = ctx;
+   mach_vm_address_t a = 0;
+   mach_vm_size_t s = 0;
+   kern_return_t kr = IOConnectMapMemory64(c->conn, handle, mach_task_self(), &a, &s, kIOMapAnywhere);
+   if (kr == kIOReturnSuccess) {
+      *addr = (void *)(uintptr_t)a;
+      *size = (size_t)s;
+   }
+   return (int)kr;
+}
+
+static int
+iokit_unmap(void *ctx, uint32_t handle, void *addr)
+{
+   struct iokit_ctx *c = ctx;
+   return (int)IOConnectUnmapMemory64(c->conn, handle, mach_task_self(), (mach_vm_address_t)(uintptr_t)addr);
+}
+
+static void
+iokit_close(void *ctx)
+{
+   struct iokit_ctx *c = ctx;
+   IOServiceClose(c->conn);
+   free(c);
+}
+
+int
+acd_kext_open_iokit(struct acd_kext **out)
+{
+   io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("Navi48Bringup"));
+   if (!svc) {
+      fprintf(stderr, "radv-darwin: IOServiceGetMatchingService(Navi48Bringup) found nothing: the Navi48 kext is "
+                      "not loaded (native backend unavailable)\n");
+      return -ENODEV;
+   }
+
+   io_connect_t conn = 0;
+   kern_return_t kr = KERN_FAILURE;
+   /* A previous client (e.g. RADV's throw-away device used for the physical-device query) may
+    * still be closing: retry ExclusiveAccess for up to 2 s. */
+   for (int tries = 0; tries < 200; tries++) {
+      kr = IOServiceOpen(svc, mach_task_self(), N48N_UC_TYPE, &conn);
+      if (kr != (kern_return_t)ACD_KR_EXCLUSIVE_ACCESS)
+         break;
+      usleep(10000);
+   }
+   IOObjectRelease(svc);
+   if (kr != KERN_SUCCESS) {
+      fprintf(stderr, "radv-darwin: IOServiceOpen(Navi48Bringup, type 'N48N') failed: IOReturn 0x%08x%s\n",
+              (unsigned)kr,
+              (unsigned)kr == ACD_KR_EXCLUSIVE_ACCESS ? " (another native client is open)"
+              : (unsigned)kr == ACD_KR_NOT_PRIVILEGED ? " (needs root)"
+              : (unsigned)kr == ACD_KR_NOT_READY      ? " (native mode not available this boot)"
+                                                      : "");
+      return acd_kr_to_errno(ACD_SEL_HELLO, (int)kr);
+   }
+
+   struct iokit_ctx *c = calloc(1, sizeof(*c));
+   if (!c) {
+      IOServiceClose(conn);
+      return -ENOMEM;
+   }
+   c->conn = conn;
+   const struct acd_kext_ops ops = {
+      .call = iokit_call,
+      .map = iokit_map,
+      .unmap = iokit_unmap,
+      .close = iokit_close,
+   };
+   *out = acd_kext_create(&ops, c);
+   return *out ? 0 : -ENOMEM;
+}
diff --git a/src/amd/common/darwin/ac_darwin_kext.c b/src/amd/common/darwin/ac_darwin_kext.c
new file mode 100644
index 00000000000..e2373f4f910
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_kext.c
@@ -0,0 +1,542 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Marshaller between the DRM_AMDGPU_* commands RADV issues and the selectors
+ * of the kext's Navi48NativeClient.  Contract: NATIVE-S1C-ABI.md (binding).
+ */
+
+#include "ac_darwin_kext.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+/* ---- the mirrored structs must be layout-identical to their drm twins (D2) ---- */
+_Static_assert(sizeof(struct n48n_gem_create_in) == 32, "gem_create_in size");
+_Static_assert(sizeof(struct n48n_gem_create_in) == sizeof(struct drm_amdgpu_gem_create_in), "gem_create_in twin");
+_Static_assert(sizeof(struct n48n_gem_va) == 64, "gem_va size");
+_Static_assert(sizeof(struct n48n_gem_va) == sizeof(struct drm_amdgpu_gem_va), "gem_va twin");
+_Static_assert(offsetof(struct n48n_gem_va, handle) == offsetof(struct drm_amdgpu_gem_va, handle), "va.handle");
+_Static_assert(offsetof(struct n48n_gem_va, operation) == offsetof(struct drm_amdgpu_gem_va, operation), "va.op");
+_Static_assert(offsetof(struct n48n_gem_va, flags) == offsetof(struct drm_amdgpu_gem_va, flags), "va.flags");
+_Static_assert(offsetof(struct n48n_gem_va, va_address) == offsetof(struct drm_amdgpu_gem_va, va_address), "va.addr");
+_Static_assert(offsetof(struct n48n_gem_va, offset_in_bo) == offsetof(struct drm_amdgpu_gem_va, offset_in_bo), "va.off");
+_Static_assert(offsetof(struct n48n_gem_va, map_size) == offsetof(struct drm_amdgpu_gem_va, map_size), "va.size");
+_Static_assert(offsetof(struct n48n_gem_va, vm_timeline_point) == offsetof(struct drm_amdgpu_gem_va, vm_timeline_point), "va.tp");
+_Static_assert(offsetof(struct n48n_gem_va, vm_timeline_syncobj_out) ==
+                  offsetof(struct drm_amdgpu_gem_va, vm_timeline_syncobj_out), "va.tso");
+_Static_assert(offsetof(struct n48n_gem_va, num_syncobj_handles) ==
+                  offsetof(struct drm_amdgpu_gem_va, num_syncobj_handles), "va.nsh");
+_Static_assert(offsetof(struct n48n_gem_va, input_fence_syncobj_handles) ==
+                  offsetof(struct drm_amdgpu_gem_va, input_fence_syncobj_handles), "va.ifsh");
+_Static_assert(sizeof(struct n48n_ctx) == 16, "ctx size");
+_Static_assert(sizeof(struct n48n_ctx) == sizeof(union drm_amdgpu_ctx), "ctx twin");
+_Static_assert(sizeof(struct n48n_cs_ib) == 32, "cs_ib size");
+_Static_assert(sizeof(struct n48n_cs_ib) == sizeof(struct drm_amdgpu_cs_chunk_ib), "cs_ib twin");
+_Static_assert(offsetof(struct n48n_cs_ib, flags) == offsetof(struct drm_amdgpu_cs_chunk_ib, flags), "ib.flags");
+_Static_assert(offsetof(struct n48n_cs_ib, va_start) == offsetof(struct drm_amdgpu_cs_chunk_ib, va_start), "ib.va");
+_Static_assert(offsetof(struct n48n_cs_ib, ib_bytes) == offsetof(struct drm_amdgpu_cs_chunk_ib, ib_bytes), "ib.bytes");
+_Static_assert(offsetof(struct n48n_cs_ib, ip_type) == offsetof(struct drm_amdgpu_cs_chunk_ib, ip_type), "ib.ip");
+_Static_assert(offsetof(struct n48n_cs_ib, ring) == offsetof(struct drm_amdgpu_cs_chunk_ib, ring), "ib.ring");
+_Static_assert(sizeof(struct n48n_cs_in) == 32, "cs_in size");
+_Static_assert(sizeof(struct n48n_info) == 192, "info size");
+
+/* my selector enum must equal the header's */
+_Static_assert(ACD_SEL_HELLO == N48N_SEL_HELLO && ACD_SEL_QUERY_INFO == N48N_SEL_QUERYINFO &&
+               ACD_SEL_READ_REGS == N48N_SEL_READREGS && ACD_SEL_BO_CREATE == N48N_SEL_BOCREATE &&
+               ACD_SEL_BO_FREE == N48N_SEL_BOFREE && ACD_SEL_GEM_VA == N48N_SEL_GEMVA &&
+               ACD_SEL_CTX == N48N_SEL_CTX && ACD_SEL_SUBMIT == N48N_SEL_SUBMIT &&
+               ACD_SEL_WAIT_SEQ == N48N_SEL_WAITSEQ, "selector numbers");
+/* the drm values the kernel interprets equal amdgpu_drm.h's */
+_Static_assert(N48N_VA_OP_MAP == AMDGPU_VA_OP_MAP && N48N_VA_OP_UNMAP == AMDGPU_VA_OP_UNMAP &&
+               N48N_VM_PAGE_EXECUTABLE == AMDGPU_VM_PAGE_EXECUTABLE && N48N_VM_MTYPE_UC == AMDGPU_VM_MTYPE_UC &&
+               N48N_VM_PAGE_PRT == AMDGPU_VM_PAGE_PRT, "va values");
+_Static_assert(N48N_CTX_OP_ALLOC == AMDGPU_CTX_OP_ALLOC_CTX && N48N_CTX_OP_FREE == AMDGPU_CTX_OP_FREE_CTX &&
+               N48N_CTX_OP_QUERY_STATE2 == AMDGPU_CTX_OP_QUERY_STATE2, "ctx ops");
+_Static_assert(N48N_IB_FLAG_CE == AMDGPU_IB_FLAG_CE && N48N_IB_FLAG_PREAMBLE == AMDGPU_IB_FLAG_PREAMBLE &&
+               N48N_IB_FLAG_TC_WB_NOT_INVALIDATE == AMDGPU_IB_FLAG_TC_WB_NOT_INVALIDATE &&
+               N48N_IB_FLAG_EMIT_MEM_SYNC == AMDGPU_IB_FLAG_EMIT_MEM_SYNC &&
+               N48N_IB_FLAG_SECURE == AMDGPU_IB_FLAGS_SECURE, "ib flags");
+_Static_assert(N48N_GEM_DOMAIN_GTT == AMDGPU_GEM_DOMAIN_GTT && N48N_GEM_DOMAIN_VRAM == AMDGPU_GEM_DOMAIN_VRAM &&
+               N48N_GEM_NO_CPU_ACCESS == AMDGPU_GEM_CREATE_NO_CPU_ACCESS &&
+               N48N_GEM_CP_MQD_GFX9 == AMDGPU_GEM_CREATE_CP_MQD_GFX9 &&
+               N48N_GEM_ENCRYPTED == AMDGPU_GEM_CREATE_ENCRYPTED &&
+               N48N_GEM_PREEMPTIBLE == AMDGPU_GEM_CREATE_PREEMPTIBLE, "gem values");
+
+struct acd_kext {
+   struct acd_kext_ops ops;
+   void *ctx;
+};
+
+struct acd_kext *
+acd_kext_create(const struct acd_kext_ops *ops, void *ctx)
+{
+   struct acd_kext *k = calloc(1, sizeof(*k));
+   if (!k) {
+      if (ops->close)
+         ops->close(ctx);
+      return NULL;
+   }
+   k->ops = *ops;
+   k->ctx = ctx;
+   return k;
+}
+
+void
+acd_kext_destroy(struct acd_kext *k)
+{
+   if (!k)
+      return;
+   if (k->ops.close)
+      k->ops.close(k->ctx);
+   free(k);
+}
+
+int
+acd_kext_open(struct acd_kext **out)
+{
+   const char *mock = getenv("RADV_DARWIN_MOCK");
+   if (mock && mock[0] == '1')
+      return acd_mock_open(out);
+   return acd_kext_open_iokit(out);
+}
+
+uint64_t
+acd_kext_now_ns(struct acd_kext *k)
+{
+   if (k->ops.now_ns)
+      return k->ops.now_ns(k->ctx);
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+/* Contract 1.1. */
+int
+acd_kr_to_errno(uint32_t sel, int kr_signed)
+{
+   const uint32_t kr = (uint32_t)kr_signed;
+   switch (kr) {
+   case ACD_KR_SUCCESS:
+      return 0;
+   case ACD_KR_BAD_ARGUMENT:
+      return -EINVAL;
+   case ACD_KR_NOT_FOUND:
+      return -ENOENT;
+   case ACD_KR_UNSUPPORTED:
+      return sel == ACD_SEL_HELLO ? -ENODEV : -EINVAL;
+   case ACD_KR_NO_MEMORY:
+   case ACD_KR_NO_RESOURCES:
+      return -ENOMEM;
+   case ACD_KR_NOT_READY:
+      return -ENODEV;
+   case ACD_KR_EXCLUSIVE_ACCESS:
+      return -EBUSY;
+   case ACD_KR_NOT_PRIVILEGED:
+   case ACD_KR_NOT_PERMITTED:
+      return -EACCES;
+   case ACD_KR_TIMEOUT:
+      return -ETIME; /* RADV: DEVICE_LOST (the call that detected the hang) */
+   case ACD_KR_ABORTED:
+      return -ECANCELED; /* RADV: DEVICE_LOST (every later GPU call) */
+   default:
+      break;
+   }
+   /* any mach/IPC error (kext gone): MACH_SEND_INVALID_DEST 0x10000003 and friends,
+    * MACH_SEND_* 0x1000xxxx, MACH_RCV_* 0x1000{4,5}xxx, MIG_SERVER_DIED -300 */
+   if ((kr & 0xffff0000u) == 0x10000000u || kr == 0xfffffed4u)
+      return -ENODEV;
+   fprintf(stderr, "radv-darwin: sel %u -> 0x%08x\n", sel, kr);
+   return -EIO;
+}
+
+static inline void
+acd_sfence(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+   __builtin_ia32_sfence();
+#else
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+#endif
+}
+
+static bool
+trace_enabled(void)
+{
+   static int t = -1;
+   if (t < 0) {
+      const char *v = getenv("RADV_DARWIN_TRACE");
+      t = v && v[0] == '1';
+   }
+   return t;
+}
+
+static int
+kcall(struct acd_kext *k, uint32_t sel, const uint64_t *sin, uint32_t nsin, const void *stin,
+      size_t stinsz, uint64_t *sout, uint32_t *nsout, void *stout, size_t *stoutsz)
+{
+   int kr = k->ops.call(k->ctx, sel, sin, nsin, stin, stinsz, sout, nsout, stout, stoutsz);
+   const int r = acd_kr_to_errno(sel, kr);
+   if (trace_enabled())
+      fprintf(stderr, "radv-darwin: trace sel %u nsin %u stin %zu -> IOReturn 0x%08x errno %d\n", sel, nsin, stinsz,
+              (unsigned)kr, r);
+   return r;
+}
+
+/* ---- pure helpers ---- */
+
+uint32_t
+acd_canon_bits_ok(uint64_t va)
+{
+   uint64_t top = va >> 47; /* bits 63..47, 17 bits */
+   return top == 0 || top == 0x1ffffull;
+}
+
+bool
+acd_wait_expired(uint64_t abs_deadline_ns, uint64_t now_ns)
+{
+   return abs_deadline_ns != ACD_TIMEOUT_INFINITE && now_ns >= abs_deadline_ns;
+}
+
+/* Relative ns for the next WaitSeq call, clamped to [0, 2 s]. */
+uint64_t
+acd_wait_slice_ns(uint64_t abs_deadline_ns, uint64_t now_ns)
+{
+   if (abs_deadline_ns == ACD_TIMEOUT_INFINITE)
+      return N48N_WAIT_CAP_NS;
+   if (now_ns >= abs_deadline_ns)
+      return 0;
+   uint64_t rem = abs_deadline_ns - now_ns;
+   return rem > N48N_WAIT_CAP_NS ? N48N_WAIT_CAP_NS : rem;
+}
+
+uint32_t
+acd_cs_split_count(uint32_t n_ibs)
+{
+   return (n_ibs + N48N_MAX_IBS - 1) / N48N_MAX_IBS;
+}
+
+/* ---- selectors ---- */
+
+int
+acd_kext_hello(struct acd_kext *k, struct acd_hello *out)
+{
+   const uint64_t sin[2] = {N48N_ABI_VERSION, 0};
+   uint64_t sout[4] = {0};
+   uint32_t nout = 4;
+   int r = kcall(k, ACD_SEL_HELLO, sin, 2, NULL, 0, sout, &nout, NULL, NULL);
+   if (r)
+      return r;
+   if (nout != 4)
+      return -EIO;
+   out->abi = (uint32_t)sout[0];
+   out->build = (uint32_t)sout[1];
+   out->max_ibs = (uint32_t)sout[2];
+   out->vmid = (uint32_t)sout[3];
+   return 0;
+}
+
+int
+acd_kext_query_info(struct acd_kext *k, struct n48n_info *info)
+{
+   size_t sz = sizeof(*info);
+   memset(info, 0, sizeof(*info));
+   int r = kcall(k, ACD_SEL_QUERY_INFO, NULL, 0, NULL, 0, NULL, NULL, info, &sz);
+   if (r)
+      return r;
+   return sz == sizeof(*info) ? 0 : -EIO;
+}
+
+int
+acd_kext_read_regs(struct acd_kext *k, uint32_t dword_offset, uint32_t count, uint32_t *vals)
+{
+   if (count < 1 || count > 16)
+      return -EINVAL;
+   const uint64_t sin[3] = {dword_offset, count, 0xFFFFFFFFull};
+   size_t sz = count * sizeof(uint32_t);
+   int r = kcall(k, ACD_SEL_READ_REGS, sin, 3, NULL, 0, NULL, NULL, vals, &sz);
+   if (r)
+      return r;
+   return sz == count * sizeof(uint32_t) ? 0 : -EIO;
+}
+
+int
+acd_kext_bo_create(struct acd_kext *k, const struct n48n_gem_create_in *in, struct acd_bo_created *out)
+{
+   uint64_t sout[4] = {0};
+   uint32_t nout = 4;
+   int r = kcall(k, ACD_SEL_BO_CREATE, NULL, 0, in, sizeof(*in), sout, &nout, NULL, NULL);
+   if (r)
+      return r;
+   if (nout != 4 || sout[0] == 0 || sout[0] >= N48N_MAX_BOS)
+      return -EIO;
+   out->handle = (uint32_t)sout[0];
+   out->size = sout[1];
+   out->domain = (uint32_t)sout[2];
+   out->bits = (uint32_t)sout[3];
+   return 0;
+}
+
+int
+acd_kext_bo_free(struct acd_kext *k, uint32_t handle)
+{
+   const uint64_t sin[1] = {handle};
+   acd_sfence();
+   return kcall(k, ACD_SEL_BO_FREE, sin, 1, NULL, 0, NULL, NULL, NULL, NULL);
+}
+
+int
+acd_kext_bo_map(struct acd_kext *k, uint32_t handle, void **addr, size_t *size)
+{
+   int kr = k->ops.map(k->ctx, handle, addr, size);
+   /* the map path is not a selector: use sel 0xffffffff in the unknown-code log line */
+   return acd_kr_to_errno(0xffffffffu, kr);
+}
+
+int
+acd_kext_bo_unmap(struct acd_kext *k, uint32_t handle, void *addr)
+{
+   int kr = k->ops.unmap(k->ctx, handle, addr);
+   return acd_kr_to_errno(0xffffffffu, kr);
+}
+
+int
+acd_kext_gem_va(struct acd_kext *k, const struct drm_amdgpu_gem_va *va)
+{
+   struct n48n_gem_va w;
+   memset(&w, 0, sizeof(w));
+   w.handle = va->handle;
+   w.operation = va->operation;
+   w.flags = va->flags;
+   w.va_address = va->va_address;
+   w.offset_in_bo = va->offset_in_bo;
+   w.map_size = va->map_size;
+   /* vm_timeline_*, num_syncobj_handles and the input-fence pointer stay 0: Mesa
+    * consumes them (MAP is synchronous). */
+   acd_sfence();
+   return kcall(k, ACD_SEL_GEM_VA, NULL, 0, &w, sizeof(w), NULL, NULL, NULL, NULL);
+}
+
+int
+acd_kext_ctx(struct acd_kext *k, const struct n48n_ctx *in, struct n48n_ctx *out)
+{
+   size_t sz = sizeof(*out);
+   memset(out, 0, sizeof(*out));
+   int r = kcall(k, ACD_SEL_CTX, NULL, 0, in, sizeof(*in), NULL, NULL, out, &sz);
+   if (r)
+      return r;
+   return sz == sizeof(*out) ? 0 : -EIO;
+}
+
+/* ---- CS ---- */
+
+void
+acd_cs_plan_fini(struct acd_cs_plan *plan)
+{
+   free(plan->ibs);
+   free(plan->waits);
+   free(plan->signals);
+   memset(plan, 0, sizeof(*plan));
+}
+
+static int
+plan_add_sync(struct acd_cs_sync **arr, uint32_t *n, uint32_t extra, const struct acd_cs_sync *items)
+{
+   struct acd_cs_sync *t = realloc(*arr, (*n + extra) * sizeof(**arr));
+   if (!t)
+      return -ENOMEM;
+   *arr = t;
+   memcpy(t + *n, items, extra * sizeof(*items));
+   *n += extra;
+   return 0;
+}
+
+static int
+plan_parse_syncobj(struct acd_cs_sync **arr, uint32_t *n, const struct drm_amdgpu_cs_chunk *c, bool timeline)
+{
+   const size_t esz = timeline ? sizeof(struct drm_amdgpu_cs_chunk_syncobj) : sizeof(struct drm_amdgpu_cs_chunk_sem);
+   const size_t bytes = (size_t)c->length_dw * 4;
+   if (bytes % esz)
+      return -EINVAL;
+   const uint32_t count = (uint32_t)(bytes / esz);
+   for (uint32_t i = 0; i < count; i++) {
+      struct acd_cs_sync s;
+      if (timeline) {
+         const struct drm_amdgpu_cs_chunk_syncobj *e =
+            (const struct drm_amdgpu_cs_chunk_syncobj *)(uintptr_t)c->chunk_data + i;
+         s = (struct acd_cs_sync){.handle = e->handle, .point = e->point, .timeline = true};
+      } else {
+         const struct drm_amdgpu_cs_chunk_sem *e = (const struct drm_amdgpu_cs_chunk_sem *)(uintptr_t)c->chunk_data + i;
+         s = (struct acd_cs_sync){.handle = e->handle, .point = 0, .timeline = false};
+      }
+      int r = plan_add_sync(arr, n, 1, &s);
+      if (r)
+         return r;
+   }
+   return 0;
+}
+
+int
+acd_cs_plan_init(struct acd_cs_plan *plan, uint32_t ctx_id, uint32_t bo_list_handle, uint32_t num_chunks,
+                 const uint64_t *chunks)
+{
+   memset(plan, 0, sizeof(*plan));
+   plan->ctx_id = ctx_id;
+
+   /* bo_list_handle must be 0 (RADV passes 0; the BO_HANDLES chunk is ignored: always-valid) */
+   if (bo_list_handle != 0)
+      return -EINVAL;
+
+   uint32_t n_ib = 0;
+   for (uint32_t i = 0; i < num_chunks; i++) {
+      const struct drm_amdgpu_cs_chunk *c = (const struct drm_amdgpu_cs_chunk *)(uintptr_t)chunks[i];
+      if (c->chunk_id == AMDGPU_CHUNK_ID_IB)
+         n_ib++;
+   }
+   if (n_ib == 0)
+      return -EINVAL;
+   plan->ibs = calloc(n_ib, sizeof(*plan->ibs));
+   if (!plan->ibs)
+      return -ENOMEM;
+
+   int r = 0;
+   for (uint32_t i = 0; i < num_chunks && !r; i++) {
+      const struct drm_amdgpu_cs_chunk *c = (const struct drm_amdgpu_cs_chunk *)(uintptr_t)chunks[i];
+      switch (c->chunk_id) {
+      case AMDGPU_CHUNK_ID_IB: {
+         if (c->length_dw * 4 != sizeof(struct drm_amdgpu_cs_chunk_ib)) {
+            r = -EINVAL;
+            break;
+         }
+         const struct drm_amdgpu_cs_chunk_ib *ib = (const void *)(uintptr_t)c->chunk_data;
+         plan->ibs[plan->n_ibs++] = (struct n48n_cs_ib){
+            ._pad = 0,
+            .flags = ib->flags,
+            .va_start = ib->va_start,
+            .ib_bytes = ib->ib_bytes,
+            .ip_type = ib->ip_type,
+            .ip_instance = ib->ip_instance,
+            .ring = ib->ring,
+         };
+         break;
+      }
+      case AMDGPU_CHUNK_ID_FENCE: {
+         if (plan->has_fence || c->length_dw * 4 != sizeof(struct drm_amdgpu_cs_chunk_fence)) {
+            r = -EINVAL; /* at most one user fence per CS */
+            break;
+         }
+         const struct drm_amdgpu_cs_chunk_fence *f = (const void *)(uintptr_t)c->chunk_data;
+         plan->has_fence = true;
+         plan->fence_handle = f->handle;
+         plan->fence_offset = f->offset;
+         break;
+      }
+      case AMDGPU_CHUNK_ID_DEPENDENCIES:
+      case AMDGPU_CHUNK_ID_SCHEDULED_DEPENDENCIES:
+      case AMDGPU_CHUNK_ID_BO_HANDLES:
+         break; /* ignored: one ring, always-valid */
+      case AMDGPU_CHUNK_ID_SYNCOBJ_IN:
+         r = plan_parse_syncobj(&plan->waits, &plan->n_waits, c, false);
+         break;
+      case AMDGPU_CHUNK_ID_SYNCOBJ_TIMELINE_WAIT:
+         r = plan_parse_syncobj(&plan->waits, &plan->n_waits, c, true);
+         break;
+      case AMDGPU_CHUNK_ID_SYNCOBJ_OUT:
+         r = plan_parse_syncobj(&plan->signals, &plan->n_signals, c, false);
+         break;
+      case AMDGPU_CHUNK_ID_SYNCOBJ_TIMELINE_SIGNAL:
+         r = plan_parse_syncobj(&plan->signals, &plan->n_signals, c, true);
+         break;
+      case AMDGPU_CHUNK_ID_CP_GFX_SHADOW:
+      default:
+         r = -EINVAL;
+         break;
+      }
+   }
+   if (r)
+      acd_cs_plan_fini(plan);
+   return r;
+}
+
+int
+acd_kext_submit(struct acd_kext *k, const struct acd_cs_plan *plan, uint64_t *last_seqno)
+{
+   uint8_t buf[sizeof(struct n48n_cs_in) + N48N_MAX_IBS * sizeof(struct n48n_cs_ib)];
+   uint64_t seq = 0;
+
+   if (plan->n_ibs == 0)
+      return -EINVAL;
+
+   for (uint32_t off = 0; off < plan->n_ibs; off += N48N_MAX_IBS) {
+      uint32_t n = plan->n_ibs - off;
+      if (n > N48N_MAX_IBS)
+         n = N48N_MAX_IBS;
+      const bool last = off + n == plan->n_ibs;
+
+      struct n48n_cs_in hdr;
+      memset(&hdr, 0, sizeof(hdr));
+      hdr.abi = N48N_ABI_VERSION;
+      hdr.ctx_id = plan->ctx_id;
+      hdr.num_ibs = n;
+      if (last && plan->has_fence) {
+         hdr.flags = N48N_CS_HAS_FENCE;
+         hdr.fence_handle = plan->fence_handle;
+         hdr.fence_offset = plan->fence_offset;
+      }
+      memcpy(buf, &hdr, sizeof(hdr));
+      memcpy(buf + sizeof(hdr), plan->ibs + off, n * sizeof(struct n48n_cs_ib));
+
+      uint64_t sout[1] = {0};
+      uint32_t nout = 1;
+      acd_sfence();
+      int r = kcall(k, ACD_SEL_SUBMIT, NULL, 0, buf, sizeof(hdr) + n * sizeof(struct n48n_cs_ib), sout, &nout,
+                    NULL, NULL);
+      if (r)
+         return r;
+      if (nout != 1)
+         return -EIO;
+      seq = sout[0];
+   }
+   *last_seqno = seq;
+   return 0;
+}
+
+int
+acd_kext_wait_seq(struct acd_kext *k, uint64_t seq, uint64_t rel_ns, bool *busy, struct acd_wait_status *st)
+{
+   if (rel_ns > N48N_WAIT_CAP_NS)
+      rel_ns = N48N_WAIT_CAP_NS;
+   const uint64_t sin[3] = {seq, rel_ns, 0};
+   uint64_t sout[3] = {0};
+   uint32_t nout = 3;
+   int r = kcall(k, ACD_SEL_WAIT_SEQ, sin, 3, NULL, 0, sout, &nout, NULL, NULL);
+   if (r)
+      return r;
+   if (nout != 3)
+      return -EIO;
+   *busy = sout[0] != 0;
+   if (st) {
+      st->retired = sout[1];
+      st->emitted = sout[2];
+   }
+   return 0;
+}
+
+int
+acd_kext_wait_deadline(struct acd_kext *k, uint64_t seq, uint64_t abs_deadline_ns, bool *busy)
+{
+   for (;;) {
+      const uint64_t slice = acd_wait_slice_ns(abs_deadline_ns, acd_kext_now_ns(k));
+      int r = acd_kext_wait_seq(k, seq, slice, busy, NULL);
+      if (r)
+         return r;
+      if (!*busy)
+         return 0;
+      if (acd_wait_expired(abs_deadline_ns, acd_kext_now_ns(k))) {
+         *busy = true;
+         return 0;
+      }
+   }
+}
diff --git a/src/amd/common/darwin/ac_darwin_kext.h b/src/amd/common/darwin/ac_darwin_kext.h
new file mode 100644
index 00000000000..cd8e60c65c6
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_kext.h
@@ -0,0 +1,163 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Mesa side of the Navi48 native kext ABI (NATIVE-S1C-ABI.md): the marshaller
+ * from DRM_AMDGPU_* commands to the Navi48NativeClient selectors.
+ *
+ * The transport (IOKit, the in-process mock, or a test double) is a small
+ * ops table, so everything in ac_darwin_kext.c is plain C with no IOKit
+ * dependency and can be unit-tested against a fake IOConnectCallMethod.
+ */
+#ifndef AC_DARWIN_KEXT_H
+#define AC_DARWIN_KEXT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "drm-uapi/amdgpu_drm.h"
+#include "navi48_native_abi.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Selector numbers, contract section 2. */
+enum acd_sel {
+   ACD_SEL_HELLO = 0,
+   ACD_SEL_QUERY_INFO = 1,
+   ACD_SEL_READ_REGS = 2,
+   ACD_SEL_BO_CREATE = 3,
+   ACD_SEL_BO_FREE = 4,
+   ACD_SEL_GEM_VA = 5,
+   ACD_SEL_CTX = 6,
+   ACD_SEL_SUBMIT = 7,
+   ACD_SEL_WAIT_SEQ = 8,
+};
+
+/* IOReturn values, contract section 1.1 (numeric, so this file needs no IOKit). */
+#define ACD_KR_SUCCESS          0x00000000u
+#define ACD_KR_BAD_ARGUMENT     0xe00002c2u
+#define ACD_KR_NOT_FOUND        0xe00002f0u
+#define ACD_KR_UNSUPPORTED      0xe00002c7u
+#define ACD_KR_NO_MEMORY        0xe00002bdu
+#define ACD_KR_NO_RESOURCES     0xe00002beu
+#define ACD_KR_NOT_READY        0xe00002d8u
+#define ACD_KR_EXCLUSIVE_ACCESS 0xe00002c5u
+#define ACD_KR_NOT_PRIVILEGED   0xe00002c1u
+#define ACD_KR_NOT_PERMITTED    0xe00002e2u
+#define ACD_KR_TIMEOUT          0xe00002d6u
+#define ACD_KR_ABORTED          0xe00002ebu
+
+#define ACD_TIMEOUT_INFINITE    0xffffffffffffffffull /* == AMDGPU_TIMEOUT_INFINITE */
+#define ACD_GB_ADDR_CONFIG_GFX1201 0x08200545u
+#define ACD_GB_ADDR_CONFIG_REG     0x263eu
+
+struct acd_kext_ops {
+   /* IOConnectCallMethod; returns the kern_return_t / IOReturn. */
+   int (*call)(void *ctx, uint32_t sel, const uint64_t *scalar_in, uint32_t n_scalar_in,
+               const void *struct_in, size_t struct_in_size, uint64_t *scalar_out,
+               uint32_t *n_scalar_out, void *struct_out, size_t *struct_out_size);
+   /* IOConnectMapMemory64(conn, handle, ...) / IOConnectUnmapMemory64; kern_return_t. */
+   int (*map)(void *ctx, uint32_t handle, void **addr, size_t *size);
+   int (*unmap)(void *ctx, uint32_t handle, void *addr);
+   /* IOServiceClose. */
+   void (*close)(void *ctx);
+   /* CLOCK_MONOTONIC in ns; NULL = clock_gettime. */
+   uint64_t (*now_ns)(void *ctx);
+};
+
+struct acd_kext;
+
+/* Takes ownership of ctx (ops->close is called at destroy). */
+struct acd_kext *acd_kext_create(const struct acd_kext_ops *ops, void *ctx);
+void acd_kext_destroy(struct acd_kext *k);
+
+/* Backend selection: RADV_DARWIN_MOCK=1 gives the in-process mock, otherwise the
+ * IOKit transport (IOServiceOpen of Navi48Bringup, type 'N48N'). Logs one clear
+ * stderr line and returns -errno on failure. */
+int acd_kext_open(struct acd_kext **out);
+int acd_kext_open_iokit(struct acd_kext **out);      /* ac_darwin_iokit.c */
+int acd_mock_open(struct acd_kext **out);            /* ac_darwin_mock.c */
+
+/* Error mapping, contract section 1.1. Logs the "sel %u -> 0x%08x" line for unknown codes. */
+int acd_kr_to_errno(uint32_t sel, int kr);
+
+/* Pure helpers (unit-tested). */
+uint64_t acd_wait_slice_ns(uint64_t abs_deadline_ns, uint64_t now_ns);
+bool acd_wait_expired(uint64_t abs_deadline_ns, uint64_t now_ns);
+uint32_t acd_canon_bits_ok(uint64_t va); /* 1 if bits 63..47 are all equal */
+
+struct acd_hello {
+   uint32_t abi, build, max_ibs, vmid;
+};
+
+int acd_kext_hello(struct acd_kext *k, struct acd_hello *out);
+int acd_kext_query_info(struct acd_kext *k, struct n48n_info *info);
+int acd_kext_read_regs(struct acd_kext *k, uint32_t dword_offset, uint32_t count, uint32_t *vals);
+
+struct acd_bo_created {
+   uint32_t handle;
+   uint64_t size;
+   uint32_t domain; /* placed: 2 GTT / 4 VRAM */
+   uint32_t bits;   /* N48N_PLACED_* */
+};
+int acd_kext_bo_create(struct acd_kext *k, const struct n48n_gem_create_in *in, struct acd_bo_created *out);
+int acd_kext_bo_free(struct acd_kext *k, uint32_t handle);
+int acd_kext_bo_map(struct acd_kext *k, uint32_t handle, void **addr, size_t *size);
+int acd_kext_bo_unmap(struct acd_kext *k, uint32_t handle, void *addr);
+
+/* Marshals a drm_amdgpu_gem_va (timeline/syncobj fields are zeroed on the wire). */
+int acd_kext_gem_va(struct acd_kext *k, const struct drm_amdgpu_gem_va *va);
+int acd_kext_ctx(struct acd_kext *k, const struct n48n_ctx *in, struct n48n_ctx *out);
+
+/* ---- CS ---- */
+struct acd_cs_sync {
+   uint32_t handle;
+   uint64_t point;
+   bool timeline;
+};
+
+struct acd_cs_plan {
+   uint32_t ctx_id;
+   struct n48n_cs_ib *ibs; /* copied verbatim from the IB chunks, in order */
+   uint32_t n_ibs;
+   bool has_fence;
+   uint32_t fence_handle;
+   uint32_t fence_offset; /* bytes */
+   struct acd_cs_sync *waits;
+   uint32_t n_waits;
+   struct acd_cs_sync *signals;
+   uint32_t n_signals;
+};
+
+/* Classifies the chunks (contract 4.2). chunks is the array of pointers to
+ * struct drm_amdgpu_cs_chunk (drm_amdgpu_cs_in.chunks). Returns 0 or -EINVAL /
+ * -ENOMEM. The plan must be released with acd_cs_plan_fini(). */
+int acd_cs_plan_init(struct acd_cs_plan *plan, uint32_t ctx_id, uint32_t bo_list_handle,
+                     uint32_t num_chunks, const uint64_t *chunks);
+void acd_cs_plan_fini(struct acd_cs_plan *plan);
+
+/* Splits into Submits of <= N48N_MAX_IBS IBs (fence on the last only). Returns
+ * the last seqno. */
+int acd_kext_submit(struct acd_kext *k, const struct acd_cs_plan *plan, uint64_t *last_seqno);
+/* Number of Submit calls a plan of n IBs needs. */
+uint32_t acd_cs_split_count(uint32_t n_ibs);
+
+struct acd_wait_status {
+   uint64_t retired, emitted;
+};
+/* One WaitSeq call, relative ns (capped to 2 s here as in the kernel). *busy 0/1. */
+int acd_kext_wait_seq(struct acd_kext *k, uint64_t seq, uint64_t rel_ns, bool *busy,
+                      struct acd_wait_status *st);
+/* Loops WaitSeq in <= 2 s slices to an absolute CLOCK_MONOTONIC deadline
+ * (or ACD_TIMEOUT_INFINITE). *busy = 1 when the deadline passed first. */
+int acd_kext_wait_deadline(struct acd_kext *k, uint64_t seq, uint64_t abs_deadline_ns, bool *busy);
+
+uint64_t acd_kext_now_ns(struct acd_kext *k);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/amd/common/darwin/ac_darwin_mock.c b/src/amd/common/darwin/ac_darwin_mock.c
new file mode 100644
index 00000000000..87d297a8d53
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_mock.c
@@ -0,0 +1,600 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * In-process mock of the kext's Navi48NativeClient (RADV_DARWIN_MOCK=1).
+ *
+ * It implements the selectors of NATIVE-S1C-ABI.md with the kernel's own
+ * argument validation (exact scalar counts and struct sizes, canonical VAs,
+ * overlap refusal, IB coverage by EXEC mappings, fence bounds, ctx table,
+ * seqno rules), keeps BOs in host memory, and "retires" every Submit at once
+ * (RADV_DARWIN_MOCK_LAG_MS=n delays retirement to exercise the wait loops).
+ * The user fence is written into the fence BO.  Nothing executes the IBs, so
+ * buffer contents produced by the GPU are NOT reproduced: this proves the
+ * marshalling, not the hardware.
+ */
+
+#include "ac_darwin_kext.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define MOCK_MAX_MAPS 4096
+#define MOCK_VIS_TOTAL (168ull << 20)
+#define MOCK_HI_TOTAL (15ull << 30)
+#define MOCK_GTT_CAP (512ull << 20)
+#define MOCK_GTT_MAX_BO (64ull << 20)
+#define MOCK_PT_CAP (32ull << 20)
+#define MOCK_VA_MASK ((1ull << 48) - 1)
+
+struct mock_bo {
+   bool used;
+   uint8_t *mem;
+   uint64_t size;
+   uint32_t domain;
+   uint32_t bits;
+};
+
+struct mock_map {
+   bool used;
+   uint32_t handle;
+   uint64_t va; /* stripped to 48 bits */
+   uint64_t size;
+   uint64_t off;
+   uint32_t flags;
+};
+
+struct mock {
+   pthread_mutex_t lock;
+   bool hello;
+   struct mock_bo bo[N48N_MAX_BOS];
+   struct mock_map maps[MOCK_MAX_MAPS];
+   bool ctx[N48N_MAX_CTX + 1];
+   uint64_t vis_used, hi_used, gtt_used;
+   uint64_t emitted, retired_at_submit, last_submit_ns;
+   uint64_t lag_ns;
+   uint64_t submits;
+   bool hang_mode; /* RADV_DARWIN_MOCK_HANG=1: the first WaitSeq on a submitted seq reports the hang */
+   bool hung;
+};
+
+static pthread_mutex_t g_open_lock = PTHREAD_MUTEX_INITIALIZER;
+static bool g_open;
+
+static uint64_t
+mnow(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static uint64_t
+retired_locked(struct mock *m)
+{
+   if (m->lag_ns == 0 || mnow() >= m->last_submit_ns + m->lag_ns)
+      return m->emitted;
+   return m->retired_at_submit;
+}
+
+static bool
+mock_trace(void)
+{
+   const char *v = getenv("RADV_DARWIN_TRACE");
+   return v && v[0] == '1';
+}
+
+/* return a kernel refusal, saying which check fired when tracing */
+#define REFUSE(code, why)                                                                          \
+   do {                                                                                            \
+      if (mock_trace())                                                                            \
+         fprintf(stderr, "radv-darwin: mock refuses (line %d): %s\n", __LINE__, why);              \
+      return (code);                                                                               \
+   } while (0)
+
+static struct mock_bo *
+find_bo(struct mock *m, uint32_t h)
+{
+   if (h == 0 || h >= N48N_MAX_BOS || !m->bo[h].used)
+      return NULL;
+   return &m->bo[h];
+}
+
+static int
+do_bo_create(struct mock *m, const struct n48n_gem_create_in *in, uint64_t *sout)
+{
+   uint64_t size = in->bo_size;
+   if (size == 0)
+      return ACD_KR_BAD_ARGUMENT;
+   size = (size + 4095) & ~4095ull;
+   uint64_t align = in->alignment;
+   if (align && ((align & (align - 1)) || align > (2ull << 20)))
+      return ACD_KR_BAD_ARGUMENT;
+   if (align < 4096)
+      align = 4096;
+
+   const uint64_t d = in->domains, f = in->domain_flags;
+   if (d == 0 || (d & ~(uint64_t)(AMDGPU_GEM_DOMAIN_GTT | AMDGPU_GEM_DOMAIN_VRAM)))
+      return ACD_KR_UNSUPPORTED;
+   if (f & (AMDGPU_GEM_CREATE_ENCRYPTED | AMDGPU_GEM_CREATE_CP_MQD_GFX9 | AMDGPU_GEM_CREATE_PREEMPTIBLE))
+      return ACD_KR_UNSUPPORTED;
+
+   uint32_t domain, bits;
+   if (d & AMDGPU_GEM_DOMAIN_VRAM) {
+      if (m->vis_used + size <= MOCK_VIS_TOTAL) {
+         domain = 4;
+         bits = N48N_PLACED_CPU_MAPPABLE | N48N_PLACED_ZEROED;
+         m->vis_used += size;
+      } else if ((f & AMDGPU_GEM_CREATE_NO_CPU_ACCESS) && !(f & AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED) &&
+                 m->hi_used + size <= MOCK_HI_TOTAL) {
+         domain = 4;
+         bits = N48N_PLACED_HI_POOL;
+         m->hi_used += size;
+      } else {
+         return ACD_KR_NO_MEMORY;
+      }
+   } else {
+      if (size > MOCK_GTT_MAX_BO || m->gtt_used + size > MOCK_GTT_CAP)
+         return ACD_KR_NO_MEMORY;
+      domain = 2;
+      bits = N48N_PLACED_ZEROED;
+      m->gtt_used += size;
+   }
+
+   uint32_t h = 1;
+   while (h < N48N_MAX_BOS && m->bo[h].used)
+      h++;
+   if (h >= N48N_MAX_BOS)
+      return ACD_KR_NO_RESOURCES;
+
+   void *mem = NULL;
+   if (posix_memalign(&mem, align < sizeof(void *) ? sizeof(void *) : align, size)) {
+      return ACD_KR_NO_MEMORY;
+   }
+   memset(mem, 0, size);
+   m->bo[h] = (struct mock_bo){.used = true, .mem = mem, .size = size, .domain = domain, .bits = bits};
+   sout[0] = h;
+   sout[1] = size;
+   sout[2] = domain;
+   sout[3] = bits;
+   return ACD_KR_SUCCESS;
+}
+
+static void
+unmap_all_of(struct mock *m, uint32_t h)
+{
+   for (int i = 0; i < MOCK_MAX_MAPS; i++)
+      if (m->maps[i].used && m->maps[i].handle == h)
+         m->maps[i].used = false;
+}
+
+static int
+do_bo_free(struct mock *m, uint32_t h)
+{
+   struct mock_bo *b = find_bo(m, h);
+   if (!b)
+      return ACD_KR_NOT_FOUND;
+   unmap_all_of(m, h);
+   if (b->domain == 2)
+      m->gtt_used -= b->size;
+   else if (b->bits & N48N_PLACED_HI_POOL)
+      m->hi_used -= b->size;
+   else
+      m->vis_used -= b->size;
+   free(b->mem);
+   memset(b, 0, sizeof(*b));
+   return ACD_KR_SUCCESS;
+}
+
+static int
+do_gem_va(struct mock *m, const struct n48n_gem_va *v)
+{
+   if (v->_pad || v->vm_timeline_point || v->vm_timeline_syncobj_out || v->num_syncobj_handles ||
+       v->input_fence_syncobj_handles)
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if (v->_pad || v->vm_timeline_point || v->vm_timeline_syncobj_out || v");
+   if (v->handle == 0 || (v->flags & AMDGPU_VM_PAGE_PRT))
+      REFUSE(ACD_KR_UNSUPPORTED, "if (v->handle == 0 || (v->flags & AMDGPU_VM_PAGE_PRT))");
+   if (v->operation == AMDGPU_VA_OP_CLEAR || v->operation == AMDGPU_VA_OP_REPLACE)
+      REFUSE(ACD_KR_UNSUPPORTED, "if (v->operation == AMDGPU_VA_OP_CLEAR || v->operation == AMDGPU_VA_OP");
+   if (v->operation != AMDGPU_VA_OP_MAP && v->operation != AMDGPU_VA_OP_UNMAP)
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if (v->operation != AMDGPU_VA_OP_MAP && v->operation != AMDGPU_VA_OP_U");
+   struct mock_bo *b = find_bo(m, v->handle);
+   if (!b)
+      REFUSE(ACD_KR_NOT_FOUND, "if (!b)");
+   if (!acd_canon_bits_ok(v->va_address))
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if (!acd_canon_bits_ok(v->va_address))");
+   const uint64_t va = v->va_address & MOCK_VA_MASK;
+   if ((v->va_address | v->offset_in_bo | v->map_size) & 4095 || v->map_size == 0)
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if ((v->va_address | v->offset_in_bo | v->map_size) & 4095 || v->map_s");
+   if (va < 0x10000 || va + v->map_size > (1ull << 48))
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if (va < 0x10000 || va + v->map_size > (1ull << 48))");
+   if (v->offset_in_bo + v->map_size > b->size)
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if (v->offset_in_bo + v->map_size > b->size)");
+
+   if (v->operation == AMDGPU_VA_OP_MAP) {
+      int freei = -1;
+      for (int i = 0; i < MOCK_MAX_MAPS; i++) {
+         if (!m->maps[i].used) {
+            if (freei < 0)
+               freei = i;
+            continue;
+         }
+         if (va < m->maps[i].va + m->maps[i].size && m->maps[i].va < va + v->map_size)
+            REFUSE(ACD_KR_BAD_ARGUMENT, "if (va < m->maps[i].va + m->maps[i].size && m->maps[i].va < va + v->ma"); /* overlap */
+      }
+      if (freei < 0)
+         REFUSE(ACD_KR_NO_MEMORY, "if (freei < 0)");
+      m->maps[freei] = (struct mock_map){.used = true,
+                                         .handle = v->handle,
+                                         .va = va,
+                                         .size = v->map_size,
+                                         .off = v->offset_in_bo,
+                                         .flags = v->flags};
+      return ACD_KR_SUCCESS;
+   }
+   for (int i = 0; i < MOCK_MAX_MAPS; i++) {
+      if (m->maps[i].used && m->maps[i].handle == v->handle && m->maps[i].va == va &&
+          m->maps[i].size == v->map_size) {
+         m->maps[i].used = false;
+         return ACD_KR_SUCCESS;
+      }
+   }
+   REFUSE(ACD_KR_BAD_ARGUMENT, "if (m->maps[i].used && m->maps[i].handle == v->handle && m->maps[i].va");
+}
+
+static bool
+ib_covered(struct mock *m, uint64_t va_canon, uint64_t bytes)
+{
+   uint64_t cur = va_canon & MOCK_VA_MASK;
+   const uint64_t end = cur + bytes;
+   while (cur < end) {
+      bool ok = false;
+      for (int i = 0; i < MOCK_MAX_MAPS; i++) {
+         const struct mock_map *mp = &m->maps[i];
+         if (mp->used && (mp->flags & AMDGPU_VM_PAGE_EXECUTABLE) && cur >= mp->va && cur < mp->va + mp->size) {
+            cur = mp->va + mp->size < end ? mp->va + mp->size : end;
+            ok = true;
+            break;
+         }
+      }
+      if (!ok)
+         return false;
+   }
+   return true;
+}
+
+static int
+do_submit(struct mock *m, const uint8_t *in, size_t insz, uint64_t *seq_out)
+{
+   if (m->hung)
+      return ACD_KR_ABORTED;
+   if (insz < sizeof(struct n48n_cs_in))
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if (insz < sizeof(struct n48n_cs_in))");
+   struct n48n_cs_in h;
+   memcpy(&h, in, sizeof(h));
+   if (h.abi != N48N_ABI_VERSION || h.num_ibs < 1 || h.num_ibs > N48N_MAX_IBS ||
+       insz != sizeof(h) + (size_t)h.num_ibs * sizeof(struct n48n_cs_ib) || h.reserved != 0 ||
+       (h.flags & ~N48N_CS_HAS_FENCE))
+      REFUSE(ACD_KR_BAD_ARGUMENT, "if (h.abi != N48N_ABI_VERSION || h.num_ibs < 1 || h.num_ibs > N48N_MAX");
+   if (h.ctx_id == 0 || h.ctx_id > N48N_MAX_CTX || !m->ctx[h.ctx_id])
+      REFUSE(ACD_KR_NOT_FOUND, "if (h.ctx_id == 0 || h.ctx_id > N48N_MAX_CTX || !m->ctx[h.ctx_id])");
+
+   for (uint32_t i = 0; i < h.num_ibs; i++) {
+      struct n48n_cs_ib ib;
+      memcpy(&ib, in + sizeof(h) + i * sizeof(ib), sizeof(ib));
+      if (ib._pad || ib.ip_type != AMDGPU_HW_IP_GFX || ib.ip_instance != 0 || ib.ring != 0)
+         REFUSE(ACD_KR_BAD_ARGUMENT, "if (ib._pad || ib.ip_type != AMDGPU_HW_IP_GFX || ib.ip_instance != 0 |");
+      if (ib.ib_bytes == 0 || (ib.ib_bytes & 3) || ib.ib_bytes > 0xFFFFFu * 4)
+         REFUSE(ACD_KR_BAD_ARGUMENT, "if (ib.ib_bytes == 0 || (ib.ib_bytes & 3) || ib.ib_bytes > 0xFFFFFu * ");
+      if (!acd_canon_bits_ok(ib.va_start) || (ib.va_start & 3))
+         REFUSE(ACD_KR_BAD_ARGUMENT, "if (!acd_canon_bits_ok(ib.va_start) || (ib.va_start & 3))");
+      if (ib.flags & (AMDGPU_IB_FLAG_CE | AMDGPU_IB_FLAG_RESET_GDS_MAX_WAVE_ID | AMDGPU_IB_FLAGS_SECURE |
+                      AMDGPU_IB_FLAG_EMIT_MEM_SYNC))
+         REFUSE(ACD_KR_UNSUPPORTED, "if (ib.flags & (AMDGPU_IB_FLAG_CE | AMDGPU_IB_FLAG_RESET_GDS_MAX_WAVE_");
+      if (ib.flags & ~(uint32_t)(AMDGPU_IB_FLAG_PREAMBLE | AMDGPU_IB_FLAG_PREEMPT |
+                                 AMDGPU_IB_FLAG_TC_WB_NOT_INVALIDATE))
+         REFUSE(ACD_KR_BAD_ARGUMENT, "if (ib.flags & ~(uint32_t)(AMDGPU_IB_FLAG_PREAMBLE | AMDGPU_IB_FLAG_PR");
+      if (!ib_covered(m, ib.va_start, ib.ib_bytes))
+         REFUSE(ACD_KR_BAD_ARGUMENT, "if (!ib_covered(m, ib.va_start, ib.ib_bytes))"); /* an unmapped IB would fault; nothing reaches the ring */
+   }
+
+   struct mock_bo *fb = NULL;
+   if (h.flags & N48N_CS_HAS_FENCE) {
+      fb = find_bo(m, h.fence_handle);
+      if (!fb)
+         REFUSE(ACD_KR_NOT_FOUND, "if (!fb)");
+      if ((h.fence_offset & 7) || (uint64_t)h.fence_offset + 8 > fb->size)
+         REFUSE(ACD_KR_BAD_ARGUMENT, "if ((h.fence_offset & 7) || (uint64_t)h.fence_offset + 8 > fb->size)");
+   } else if (h.fence_handle || h.fence_offset) {
+      REFUSE(ACD_KR_BAD_ARGUMENT, "} else if (h.fence_handle || h.fence_offset) {");
+   }
+
+   const uint64_t retired_before = retired_locked(m);
+   const uint64_t seq = ++m->emitted;
+   if (fb)
+      memcpy(fb->mem + h.fence_offset, &seq, sizeof(seq));
+   m->retired_at_submit = retired_before;
+   m->last_submit_ns = mnow();
+   m->submits++;
+   *seq_out = seq;
+   return ACD_KR_SUCCESS;
+}
+
+static int
+do_wait_seq(struct mock *m, uint64_t target, uint64_t timeout_ns, uint64_t *sout)
+{
+   pthread_mutex_lock(&m->lock);
+   const uint64_t emitted = m->emitted;
+   if (target == N48N_SEQ_LAST)
+      target = emitted;
+   if (target > emitted) {
+      pthread_mutex_unlock(&m->lock);
+      return ACD_KR_BAD_ARGUMENT;
+   }
+   if (m->hang_mode && target != 0) {
+      /* contract 6.3: the detecting call gets Timeout, every later GPU-dependent call Aborted */
+      const int kr = m->hung ? ACD_KR_ABORTED : ACD_KR_TIMEOUT;
+      if (!m->hung)
+         fprintf(stderr, "radv-darwin: mock: HUNG latched (seq emitted %llu retired 0)\n", (unsigned long long)emitted);
+      m->hung = true;
+      pthread_mutex_unlock(&m->lock);
+      return kr;
+   }
+   if (timeout_ns > N48N_WAIT_CAP_NS)
+      timeout_ns = N48N_WAIT_CAP_NS;
+   const uint64_t t0 = mnow();
+   uint64_t ret;
+   for (;;) {
+      ret = retired_locked(m);
+      if (target == 0 || ret >= target || mnow() - t0 >= timeout_ns)
+         break;
+      pthread_mutex_unlock(&m->lock);
+      usleep(200);
+      pthread_mutex_lock(&m->lock);
+   }
+   sout[0] = (target == 0 || ret >= target) ? 0 : 1;
+   sout[1] = ret;
+   sout[2] = m->emitted;
+   pthread_mutex_unlock(&m->lock);
+   return ACD_KR_SUCCESS;
+}
+
+#define NEED(cond)                                                                                 \
+   do {                                                                                           \
+      if (!(cond)) {                                                                              \
+         kr = ACD_KR_BAD_ARGUMENT;                                                                \
+         goto out;                                                                                \
+      }                                                                                           \
+   } while (0)
+
+static int
+mock_call(void *ctx, uint32_t sel, const uint64_t *sin, uint32_t nsin, const void *stin, size_t stinsz,
+          uint64_t *sout, uint32_t *nsout, void *stout, size_t *stoutsz)
+{
+   struct mock *m = ctx;
+   int kr = ACD_KR_SUCCESS;
+   const uint32_t nout_cap = nsout ? *nsout : 0;
+   const size_t sout_cap = stoutsz ? *stoutsz : 0;
+   /* the kernel checks scalar counts and struct sizes EXACTLY (contract section 2) */
+   const bool no_sin_ptr = nsin && !sin, no_stin = stinsz && !stin;
+#define shape(wsic, wsoc, wsis, wsos)                                                              \
+   (!no_sin_ptr && !no_stin && nsin == (wsic) && nout_cap == (wsoc) && stinsz == (size_t)(wsis) && \
+    sout_cap == (size_t)(wsos) && ((wsoc) == 0 || sout) && ((wsos) == 0 || stout) && ((wsis) == 0 || stin))
+
+   if (sel == ACD_SEL_WAIT_SEQ) { /* takes no lock */
+      if (!m->hello)
+         return ACD_KR_NOT_READY;
+      if (!shape(3, 3, 0, 0))
+         return ACD_KR_BAD_ARGUMENT;
+      kr = do_wait_seq(m, sin[0], sin[1], sout);
+      if (!kr)
+         *nsout = 3;
+      return kr;
+   }
+
+   pthread_mutex_lock(&m->lock);
+   if (sel != ACD_SEL_HELLO && !m->hello) {
+      kr = ACD_KR_NOT_READY;
+      goto out;
+   }
+   switch (sel) {
+   case ACD_SEL_HELLO:
+      NEED(shape(2, 4, 0, 0));
+      NEED(sin[1] == 0);
+      if (sin[0] != N48N_ABI_VERSION) {
+         kr = ACD_KR_UNSUPPORTED;
+         goto out;
+      }
+      m->hello = true;
+      sout[0] = N48N_ABI_VERSION;
+      sout[1] = 601;
+      sout[2] = N48N_MAX_IBS;
+      sout[3] = 8;
+      *nsout = 4;
+      break;
+   case ACD_SEL_QUERY_INFO: {
+      NEED(shape(0, 0, 0, sizeof(struct n48n_info)));
+      struct n48n_info inf;
+      memset(&inf, 0, sizeof(inf));
+      inf.abi_version = N48N_ABI_VERSION;
+      inf.kext_build = 601;
+      inf.flags = N48N_INFO_S1B_POSITIVE | N48N_INFO_NATIVE_BOOT;
+      inf.vmid = 8;
+      inf.gb_addr_config = ACD_GB_ADDR_CONFIG_GFX1201;
+      inf.gc_version = (12u << 16) | (0u << 8) | 1u;
+      inf.ring_size_dw = 4096;
+      inf.max_ibs = N48N_MAX_IBS;
+      inf.vram_vis_total = MOCK_VIS_TOTAL;
+      inf.vram_vis_free = MOCK_VIS_TOTAL - m->vis_used;
+      inf.vram_hi_total = MOCK_HI_TOTAL;
+      inf.vram_hi_free = MOCK_HI_TOTAL - m->hi_used;
+      inf.gtt_cap = MOCK_GTT_CAP;
+      inf.gtt_used = m->gtt_used;
+      inf.gtt_max_bo = MOCK_GTT_MAX_BO;
+      inf.pt_cap = MOCK_PT_CAP;
+      inf.seq_emitted = m->emitted;
+      inf.seq_retired = retired_locked(m);
+      inf.va_low_first = 0x10000;
+      inf.va_low_last = 0x7FFFFFFFFFFFull;
+      inf.va_high_first = 0xFFFF800000000000ull;
+      inf.va_high_last = 0xFFFFFFFFFFFFFFFFull;
+      inf.max_bos = N48N_MAX_BOS;
+      inf.fence_slots = N48N_FENCE_SLOTS;
