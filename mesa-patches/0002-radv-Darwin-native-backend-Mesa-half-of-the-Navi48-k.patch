+/* AMDGPU_INFO_MEMORY and the usage queries come from the kernel (contract section 7). */
+static int
+acd_info_memory(struct acd_device *dev, const struct drm_amdgpu_info *info, void *out)
+{
+   struct n48n_info k;
+   int r = acd_kext_query_info(dev->core->kext, &k);
+   if (r)
+      return r;
+
+   const uint64_t vram_total = k.vram_vis_total + k.vram_hi_total;
+   const uint64_t vram_free = k.vram_vis_free + k.vram_hi_free;
+   switch (info->query) {
+   case AMDGPU_INFO_VRAM_USAGE:
+      *(uint64_t *)out = vram_total - vram_free;
+      return 0;
+   case AMDGPU_INFO_VIS_VRAM_USAGE:
+      *(uint64_t *)out = k.vram_vis_total - k.vram_vis_free;
+      return 0;
+   case AMDGPU_INFO_GTT_USAGE:
+      *(uint64_t *)out = k.gtt_used;
+      return 0;
+   default:
+      break;
+   }
+
+   struct drm_amdgpu_memory_info *m = out;
+   memset(m, 0, sizeof(*m));
+   m->vram.total_heap_size = vram_total;
+   m->vram.usable_heap_size = vram_total;
+   m->vram.heap_usage = vram_total - vram_free;
+   m->vram.max_allocation = k.vram_vis_total * 3 / 4;
+   m->cpu_accessible_vram.total_heap_size = k.vram_vis_total;
+   m->cpu_accessible_vram.usable_heap_size = k.vram_vis_total;
+   m->cpu_accessible_vram.heap_usage = k.vram_vis_total - k.vram_vis_free;
+   m->cpu_accessible_vram.max_allocation = k.vram_vis_total * 3 / 4;
+   m->gtt.total_heap_size = k.gtt_cap;
+   m->gtt.usable_heap_size = k.gtt_cap;
+   m->gtt.heap_usage = k.gtt_used;
+   m->gtt.max_allocation = k.gtt_max_bo;
+   return 0;
+}
