+static int
+acd_cmd_cs(struct acd_device *dev, union drm_amdgpu_cs *cs)
+{
+   const uint32_t ctx_id = cs->in.ctx_id, bo_list = cs->in.bo_list_handle, num_chunks = cs->in.num_chunks;
+   const uint64_t *chunks = (const uint64_t *)(uintptr_t)cs->in.chunks;
+
+   struct acd_cs_plan plan;
+   int r = acd_cs_plan_init(&plan, ctx_id, bo_list, num_chunks, chunks);
+   if (r)
+      return r;
+
+   /* SYNCOBJ_IN / TIMELINE_WAIT: a point backed by a seqno of this client is already ordered on
+    * the one ring; a CPU-signalled one is done; one not yet submitted is waited for on the CPU. */
+   for (uint32_t i = 0; i < plan.n_waits && !r; i++)
+      r = acd_sync_cs_wait_ready(dev->sync, plan.waits[i].handle, plan.waits[i].point, ACD_CS_DEP_TIMEOUT_NS);
+
+   uint64_t seq = 0;
+   if (!r)
+      r = acd_kext_submit(dev->core->kext, &plan, &seq);
+   /* SYNCOBJ_OUT / TIMELINE_SIGNAL: attach the returned seqno to each (handle, point). */
+   for (uint32_t i = 0; i < plan.n_signals && !r; i++)
+      r = acd_sync_cs_attach(dev->sync, plan.signals[i].handle, plan.signals[i].point, seq);
+
+   acd_cs_plan_fini(&plan);
+   if (r)
+      return r;
+   memset(&cs->out, 0, sizeof(cs->out));
+   cs->out.handle = seq;
+   return 0;
+}
+
+static int
+acd_cmd_ctx(struct acd_device *dev, union drm_amdgpu_ctx *args)
+{
+   switch (args->in.op) {
+   case AMDGPU_CTX_OP_GET_STABLE_PSTATE:
+   case AMDGPU_CTX_OP_SET_STABLE_PSTATE:
+      /* Mesa-only no-ops (contract 4.1): never reach the kernel. */
+      memset(&args->out, 0, sizeof(args->out));
+      return 0;
+   case AMDGPU_CTX_OP_ALLOC_CTX:
+   case AMDGPU_CTX_OP_FREE_CTX:
+   case AMDGPU_CTX_OP_QUERY_STATE2: {
+      struct n48n_ctx in, out;
+      memcpy(&in, &args->in, sizeof(in));
+      int r = acd_kext_ctx(dev->core->kext, &in, &out);
+      if (r)
+         return r;
+      memcpy(&args->out, &out, sizeof(out)); /* out overlays in, layouts identical (contract 2.1) */
+      return 0;
+   }
+   default:
+      return -EINVAL;
+   }
+}
+
+static int
+acd_cmd_wait_cs(struct acd_device *dev, union drm_amdgpu_wait_cs *args)
+{
+   /* in.handle: a seqno, 0 = nothing to wait for, ~0 = the newest; ip/ring/ctx are ignored. */
+   const uint64_t seq = args->in.handle, deadline = args->in.timeout;
+   bool busy = false;
+   int r = acd_kext_wait_deadline(dev->core->kext, seq, deadline, &busy);
+   if (r)
+      return r;
+   memset(&args->out, 0, sizeof(args->out));
+   args->out.status = busy;
+   return 0;
+}
+
+static int
+acd_cmd_gem_wait_idle(struct acd_device *dev, union drm_amdgpu_gem_wait_idle *args)
+{
+   /* has_vm_always_valid is always true: BO idle = whole ring idle. */
+   const uint32_t handle = args->in.handle;
+   const uint64_t deadline = args->in.timeout;
+   bool busy = false;
+   int r = acd_kext_wait_deadline(dev->core->kext, N48N_SEQ_LAST, deadline, &busy);
+   if (r)
+      return r;
+   struct amdgpu_bo *bo = bo_lookup(dev, handle);
+   memset(&args->out, 0, sizeof(args->out));
+   args->out.status = busy;
+   args->out.domain = bo ? bo->placed_domain : 0;
+   return 0;
+}
+
+static int
+acd_cmd_gem_metadata(struct acd_device *dev, struct drm_amdgpu_gem_metadata *m)
+{
+   /* Mesa-only (contract 7): SET stores <= 256 B per BO, GET returns it; always succeeds. */
+   struct amdgpu_bo *bo = bo_lookup(dev, m->handle);
+   if (!bo)
+      return -ENOENT;
+   if (m->op == AMDGPU_GEM_METADATA_OP_SET_METADATA) {
+      if (m->data.data_size_bytes > ACD_METADATA_MAX)
+         return -EINVAL;
+      bo->meta_flags = m->data.flags;
+      bo->meta_tiling = m->data.tiling_info;
+      bo->meta_size = m->data.data_size_bytes;
+      memcpy(bo->meta, m->data.data, bo->meta_size);
+      return 0;
+   }
+   if (m->op == AMDGPU_GEM_METADATA_OP_GET_METADATA) {
+      m->data.flags = bo->meta_flags;
+      m->data.tiling_info = bo->meta_tiling;
+      m->data.data_size_bytes = bo->meta_size;
+      memset(m->data.data, 0, sizeof(m->data.data));
+      memcpy(m->data.data, bo->meta, bo->meta_size);
+      return 0;
+   }
+   return -EINVAL;
+}
+
+static int
+acd_cmd_gem_op(struct acd_device *dev, struct drm_amdgpu_gem_op *op)
+{
+   struct amdgpu_bo *bo = bo_lookup(dev, op->handle);
+   if (!bo)
+      return -ENOENT;
+   switch (op->op) {
+   case AMDGPU_GEM_OP_GET_GEM_CREATE_INFO: {
+      /* from the stored create args and the placed size */
+      struct drm_amdgpu_gem_create_in *ci = (struct drm_amdgpu_gem_create_in *)(uintptr_t)op->value;
+      ci->bo_size = bo->size;
+      ci->alignment = bo->create.alignment;
+      ci->domains = bo->create.domains;
+      ci->domain_flags = bo->create.domain_flags;
+      return 0;
+   }
+   case AMDGPU_GEM_OP_SET_PLACEMENT:
+      return 0;
+   default:
+      return -EINVAL;
+   }
+}
