+              (unsigned long long)di->virtual_address_offset, (unsigned long long)di->virtual_address_max,
+              (unsigned long long)di->high_va_offset, (unsigned long long)di->high_va_max,
+              (unsigned long long)info.va_low_first, (unsigned long long)info.va_low_last,
+              (unsigned long long)info.va_high_first, (unsigned long long)info.va_high_last);
+      return -ENODEV;
+   }
+
+   static bool logged;
+   if (!logged) {
+      logged = true;
+      fprintf(stderr, "radv-darwin: native kext: ABI %u, build %u, VMID %u, max %u IBs/submit, GB_ADDR_CONFIG "
+                      "0x%08x, VRAM %llu MiB visible + %llu MiB hi, GTT cap %llu MiB\n",
+              h.abi, h.build, h.vmid, h.max_ibs, gb, (unsigned long long)(info.vram_vis_total >> 20),
+              (unsigned long long)(info.vram_hi_total >> 20), (unsigned long long)(info.gtt_cap >> 20));
+   }
