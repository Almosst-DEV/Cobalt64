+}
+
+static void
+mock_close(void *ctx)
+{
+   struct mock *m = ctx;
+   for (uint32_t h = 1; h < N48N_MAX_BOS; h++)
+      if (m->bo[h].used)
+         free(m->bo[h].mem);
+   fprintf(stderr, "radv-darwin: mock client closed: %llu submits, %llu seqs\n",
+           (unsigned long long)m->submits, (unsigned long long)m->emitted);
+   pthread_mutex_destroy(&m->lock);
+   free(m);
+   pthread_mutex_lock(&g_open_lock);
+   g_open = false;
+   pthread_mutex_unlock(&g_open_lock);
+}
+
+int
+acd_mock_open(struct acd_kext **out)
+{
+   pthread_mutex_lock(&g_open_lock);
+   if (g_open) {
+      pthread_mutex_unlock(&g_open_lock);
+      fprintf(stderr, "radv-darwin: mock: another native client is open (ExclusiveAccess)\n");
+      return -EBUSY;
+   }
+   g_open = true;
+   pthread_mutex_unlock(&g_open_lock);
+
+   struct mock *m = calloc(1, sizeof(*m));
+   if (!m) {
+      pthread_mutex_lock(&g_open_lock);
+      g_open = false;
+      pthread_mutex_unlock(&g_open_lock);
+      return -ENOMEM;
+   }
+   pthread_mutex_init(&m->lock, NULL);
+   const char *hang = getenv("RADV_DARWIN_MOCK_HANG");
+   m->hang_mode = hang && hang[0] == '1';
+   const char *lag = getenv("RADV_DARWIN_MOCK_LAG_MS");
+   if (lag)
+      m->lag_ns = strtoull(lag, NULL, 10) * 1000000ull;
+   const struct acd_kext_ops ops = {
+      .call = mock_call,
+      .map = mock_map,
+      .unmap = mock_unmap,
+      .close = mock_close,
+   };
+   fprintf(stderr, "radv-darwin: RADV_DARWIN_MOCK=1: in-process mock kext (no GPU)\n");
+   *out = acd_kext_create(&ops, m);
+   return *out ? 0 : -ENOMEM;
+}
