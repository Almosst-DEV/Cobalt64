+static void
+test_split(void)
+{
+   static struct cs_build b;
+   struct fake f;
+   struct acd_kext *k = mk(&f);
+   struct acd_cs_plan p;
+
+   /* 130 IBs -> 64 + 64 + 2, the fence only on the last, the last seqno returned */
+   memset(&b, 0, sizeof(b));
+   add_ibs(&b, 130);
+   b.fence[0] = (struct drm_amdgpu_cs_chunk_fence){.handle = 3, .offset = 16};
+   add(&b, AMDGPU_CHUNK_ID_FENCE, 2, &b.fence[0]);
+   CHECK(acd_cs_plan_init(&p, 6, 0, b.n, b.ptr) == 0);
+   uint64_t seq = 0;
+   CHECK(acd_kext_submit(k, &p, &seq) == 0);
+   CHECK(f.ncalls == 3 && seq == 3);
+   const unsigned want[3] = {64, 64, 2};
+   for (unsigned i = 0; i < 3 && i < f.ncalls; i++) {
+      const struct n48n_cs_in *h = (const struct n48n_cs_in *)f.calls[i].stin;
+      CHECK(f.calls[i].sel == ACD_SEL_SUBMIT && f.calls[i].nsin == 0);
+      CHECK(f.calls[i].stinsz == 32 + 32 * want[i]);
+      CHECK(h->abi == 1 && h->ctx_id == 6 && h->num_ibs == want[i] && h->reserved == 0);
+      CHECK((h->flags != 0) == (i == 2));
+      if (i == 2)
+         CHECK(h->flags == N48N_CS_HAS_FENCE && h->fence_handle == 3 && h->fence_offset == 16);
+      else
+         CHECK(h->fence_handle == 0 && h->fence_offset == 0);
+   }
+   /* the IBs keep their order across the split: first IB of call 1 is IB 64 */
+   const struct n48n_cs_ib *ib1 = (const struct n48n_cs_ib *)(f.calls[1].stin + 32);
+   CHECK(ib1->va_start == p.ibs[64].va_start && ib1->ib_bytes == p.ibs[64].ib_bytes);
+   acd_cs_plan_fini(&p);
+
+   /* exactly 64 -> one call; a kernel error surfaces mapped and stops the split */
+   memset(&b, 0, sizeof(b));
+   add_ibs(&b, 70);
+   CHECK(acd_cs_plan_init(&p, 6, 0, b.n, b.ptr) == 0);
