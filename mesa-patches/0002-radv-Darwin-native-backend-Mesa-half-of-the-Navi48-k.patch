+   add(&b, AMDGPU_CHUNK_ID_FENCE, 2, &b.fence[0]);
+   b.sem_in[0].handle = 11; b.sem_in[1].handle = 12;
+   add(&b, AMDGPU_CHUNK_ID_SYNCOBJ_IN, 2, b.sem_in);
+   b.tl_wait[0] = (struct drm_amdgpu_cs_chunk_syncobj){.handle = 21, .point = 5};
+   b.tl_wait[1] = (struct drm_amdgpu_cs_chunk_syncobj){.handle = 22, .point = 0};
+   add(&b, AMDGPU_CHUNK_ID_SYNCOBJ_TIMELINE_WAIT, 8, b.tl_wait);
+   b.sem_out[0].handle = 31;
+   add(&b, AMDGPU_CHUNK_ID_SYNCOBJ_OUT, 1, b.sem_out);
+   b.tl_sig[0] = (struct drm_amdgpu_cs_chunk_syncobj){.handle = 41, .point = 7};
+   add(&b, AMDGPU_CHUNK_ID_SYNCOBJ_TIMELINE_SIGNAL, 4, b.tl_sig);
+   add(&b, AMDGPU_CHUNK_ID_DEPENDENCIES, 0, NULL);
