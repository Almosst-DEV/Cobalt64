 /* ---- DRM_AMDGPU_* command emulation ---- */
 
+static int
+acd_cmd_gem_va(struct acd_device *dev, struct drm_amdgpu_gem_va *va)
+{
+   /* Mesa consumes the syncobj fields (contract 7): the wait first, the signal after. */
+   if (va->num_syncobj_handles && va->input_fence_syncobj_handles) {
+      int r = dev->sync->wait(dev->sync, (uint32_t *)(uintptr_t)va->input_fence_syncobj_handles,
+                              va->num_syncobj_handles, INT64_MAX,
+                              DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL);
+      if (r)
+         return -errno; /* provider ops return -1 with errno set */
+   }
+   const uint32_t out_handle = va->vm_timeline_syncobj_out;
+   uint64_t point = va->vm_timeline_point;
+
+   int r = acd_kext_gem_va(dev->core->kext, va);
+   if (r)
+      return r;
+   /* MAP/UNMAP are synchronous in the kernel: the timeline point is already complete. */
+   if (out_handle && dev->sync->timeline_signal(dev->sync, &out_handle, &point, 1))
+      return -errno;
+   return 0;
+}
