+/* ---- BO table (handle -> Mesa-side state) ---- */
+
+static struct amdgpu_bo *
+bo_lookup(struct acd_device *dev, uint32_t handle)
+{
+   struct amdgpu_bo *b = NULL;
+   if (handle && handle < N48N_MAX_BOS) {
+      pthread_mutex_lock(&dev->core->bo_lock);
+      b = dev->core->bos[handle];
+      pthread_mutex_unlock(&dev->core->bo_lock);
+   }
+   return b;
+}
