+/* Builds the core: connection (unless the HOST_BO stand-in), handshake, VA manager, master provider. */
+static int
+acd_core_create(const struct amdgpu_device *canned, bool host_bo, struct acd_core **out)
+{
+   struct acd_core *c = calloc(1, sizeof(*c));
+   if (!c)
+      return -ENOMEM;
+   pthread_mutex_init(&c->bo_lock, NULL);
+   c->refcount = 1;
+
+   if (!host_bo) {
+      int r = acd_kext_open(&c->kext);
+      if (r == 0)
+         r = acd_native_handshake(c->kext, canned);
+      if (r) {
+         acd_kext_destroy(c->kext);
+         pthread_mutex_destroy(&c->bo_lock);
+         free(c);
+         return r;
+      }
+   }
+
+   const struct acd_sync_backend be = {.wait_seq = acd_backend_wait_seq, .ctx = c->kext};
+   c->sync = acd_sync_provider_create(c->kext ? &be : NULL);
+   c->va_mgr = amdgpu_va_manager_alloc();
+   if (!c->sync || !c->va_mgr) {
+      free(c->va_mgr);
+      if (c->sync)
+         c->sync->finalize(c->sync);
+      acd_kext_destroy(c->kext);
+      pthread_mutex_destroy(&c->bo_lock);
+      free(c);
+      return -ENOMEM;
+   }
+
+   const struct drm_amdgpu_info_device *di = &canned->dev;
+   /* gfx12: RADV needs half of the VA range reserved for PRT, as on Linux. */
+   amdgpu_va_manager_init2(c->va_mgr, di->virtual_address_offset, di->virtual_address_max, di->high_va_offset,
+                           di->high_va_max, di->virtual_address_alignment, AMDGPU_VA_MGR_RESERVE_HALF_VA_FOR_PRT);
+   *out = c;
+   return 0;
+}
+
+static void
+acd_core_destroy(struct acd_core *c)
+{
+   amdgpu_va_manager_deinit(c->va_mgr);
+   free(c->va_mgr);
+   /* BOs RADV leaked: the kext frees them at close; only the Mesa side is released here. */
+   for (uint32_t i = 0; i < N48N_MAX_BOS; i++)
+      free(c->bos[i]);
+   acd_kext_destroy(c->kext); /* IOServiceClose */
+   c->sync->finalize(c->sync); /* clones keep the syncobj state alive as long as they need it */
+   pthread_mutex_destroy(&c->bo_lock);
+   free(c);
+}
