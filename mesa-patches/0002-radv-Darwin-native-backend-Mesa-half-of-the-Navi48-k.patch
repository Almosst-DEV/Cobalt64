+   f.next_kr = (int)ACD_KR_TIMEOUT;
+   CHECK(acd_kext_submit(k, &p, &seq) == -ETIME && f.ncalls == 1);
+   f.next_kr = (int)ACD_KR_ABORTED;
+   CHECK(acd_kext_submit(k, &p, &seq) == -ECANCELED);
+   acd_cs_plan_fini(&p);
+   acd_kext_destroy(k);
+}
