+static int
+mock_map(void *ctx, uint32_t handle, void **addr, size_t *size)
+{
+   struct mock *m = ctx;
+   pthread_mutex_lock(&m->lock);
+   int kr;
+   struct mock_bo *b = m->hello ? find_bo(m, handle) : NULL;
