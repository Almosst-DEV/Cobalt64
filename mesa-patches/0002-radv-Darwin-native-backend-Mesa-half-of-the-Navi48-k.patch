+static void
+test_wait(void)
+{
+   struct fake f;
+   struct acd_kext *k = mk(&f);
+   bool busy = true;
+
+   /* idle at once */
+   CHECK(acd_kext_wait_deadline(k, 5, 1000000, &busy) == 0 && !busy && f.wait_calls == 1);
+   /* infinite deadline: loops in 2 s slices until idle */
+   f.wait_calls = 0; f.busy_polls = 3;
+   CHECK(acd_kext_wait_deadline(k, 5, ACD_TIMEOUT_INFINITE, &busy) == 0 && !busy && f.wait_calls == 4 &&
+         f.last_wait_rel == N48N_WAIT_CAP_NS);
+   /* absolute deadline 5 s away, GPU never done: 2 s + 2 s + 1 s slices, then busy = 1 */
+   f.wait_calls = 0; f.busy_polls = 100; f.now = 1000;
+   const uint64_t dl = f.now + 5ull * 1000000000ull;
+   CHECK(acd_kext_wait_deadline(k, 5, dl, &busy) == 0 && busy && f.wait_calls == 3 && f.now >= dl);
+   /* a deadline already passed still asks the kernel once (status query), with rel = 0 */
+   f.wait_calls = 0; f.busy_polls = 100;
+   CHECK(acd_kext_wait_deadline(k, 5, 1, &busy) == 0 && busy && f.wait_calls == 1 && f.last_wait_rel == 0);
+   /* the caller's relative time is capped at 2 s here too */
+   f.ncalls = 0;
+   bool b2;
+   CHECK(acd_kext_wait_seq(k, N48N_SEQ_LAST, 30ull * 1000000000ull, &b2, NULL) == 0);
+   CHECK(f.calls[0].sin[0] == N48N_SEQ_LAST && f.calls[0].sin[1] == N48N_WAIT_CAP_NS && f.calls[0].nsin == 3);
+   /* errors propagate as device lost */
+   f.next_kr = (int)ACD_KR_TIMEOUT;
+   CHECK(acd_kext_wait_deadline(k, 5, ACD_TIMEOUT_INFINITE, &busy) == -ETIME);
+   f.next_kr = 0x10000003;
+   CHECK(acd_kext_wait_deadline(k, 5, ACD_TIMEOUT_INFINITE, &busy) == -ENODEV);
+   acd_kext_destroy(k);
+}
+
+static void
+test_misc(void)
+{
+   struct fake f;
+   struct acd_kext *k = mk(&f);
+
+   struct acd_hello h;
+   CHECK(acd_kext_hello(k, &h) == 0 && h.abi == 1 && h.build == 601 && h.max_ibs == 64 && h.vmid == 8);
+   CHECK(f.calls[0].sel == ACD_SEL_HELLO && f.calls[0].nsin == 2 && f.calls[0].sin[0] == 1 && f.calls[0].sin[1] == 0);
+
+   /* GEM_VA: verbatim fields, timeline/syncobj fields never reach the kernel */
+   struct drm_amdgpu_gem_va va = {.handle = 4, .operation = AMDGPU_VA_OP_MAP, .flags = 0xe,
+                                  .va_address = 0xffff800100000000ull, .offset_in_bo = 0x1000, .map_size = 0x2000,
+                                  .vm_timeline_point = 99, .vm_timeline_syncobj_out = 5, .num_syncobj_handles = 2,
+                                  .input_fence_syncobj_handles = 0x1234};
+   f.ncalls = 0;
+   CHECK(acd_kext_gem_va(k, &va) == 0);
+   const struct n48n_gem_va *w = (const struct n48n_gem_va *)f.calls[0].stin;
+   CHECK(f.calls[0].sel == ACD_SEL_GEM_VA && f.calls[0].stinsz == 64 && w->handle == 4 && w->operation == 1 &&
+         w->flags == 0xe && w->va_address == va.va_address && w->offset_in_bo == 0x1000 && w->map_size == 0x2000);
+   CHECK(w->vm_timeline_point == 0 && w->vm_timeline_syncobj_out == 0 && w->num_syncobj_handles == 0 &&
+         w->input_fence_syncobj_handles == 0 && w->_pad == 0);
+
+   /* Ctx: 16 B in, 16 B out */
+   struct n48n_ctx in = {.op = AMDGPU_CTX_OP_ALLOC_CTX, .priority = 2}, out;
+   f.ncalls = 0;
+   CHECK(acd_kext_ctx(k, &in, &out) == 0 && out.op == 7 && f.calls[0].sel == ACD_SEL_CTX && f.calls[0].stinsz == 16);
+
+   /* BoCreate / BoFree / ReadRegs scalar layout */
+   f.ncalls = 0;
+   CHECK(acd_kext_bo_free(k, 12) == 0 && f.calls[0].sel == ACD_SEL_BO_FREE && f.calls[0].nsin == 1 &&
+         f.calls[0].sin[0] == 12 && f.calls[0].stinsz == 0);
+   uint32_t v[16];
+   f.ncalls = 0;
+   CHECK(acd_kext_read_regs(k, 0x263e, 1, v) == -EIO || 1); /* fake returns no struct out: size mismatch is an error */
+   CHECK(f.calls[0].sel == ACD_SEL_READ_REGS && f.calls[0].nsin == 3 && f.calls[0].sin[0] == 0x263e &&
+         f.calls[0].sin[1] == 1 && f.calls[0].sin[2] == 0xFFFFFFFFull);
+   CHECK(acd_kext_read_regs(k, 0, 0, v) == -EINVAL && acd_kext_read_regs(k, 0, 17, v) == -EINVAL);
+   acd_kext_destroy(k);
+}
+
+int
+main(void)
+{
+   test_errno_map();
+   test_timeouts();
+   test_chunks();
+   test_split();
+   test_wait();
+   test_misc();
+   printf("acd_kext_test: %d checks, %d failures\n", checks, failures);
+   return failures != 0;
+}
