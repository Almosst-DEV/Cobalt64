+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Host unit test of the Mesa-side marshaller (ac_darwin_kext.c) against a fake
+ * IOConnectCallMethod.  Build and run:
+ *   clang -std=gnu11 -I include -I include/darwin -I src/amd/common/darwin \
+ *     src/amd/common/darwin/test/acd_kext_test.c src/amd/common/darwin/ac_darwin_kext.c -o acd_kext_test && ./acd_kext_test
+ */
+#include "ac_darwin_kext.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int acd_mock_open(struct acd_kext **out) { (void)out; return -ENODEV; }
+int acd_kext_open_iokit(struct acd_kext **out) { (void)out; return -ENODEV; }
+
+static int failures, checks;
+#define CHECK(c)                                                                                   \
+   do {                                                                                            \
+      checks++;                                                                                    \
+      if (!(c)) {                                                                                  \
+         failures++;                                                                               \
+         printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c);                                       \
+      }                                                                                            \
+   } while (0)
+
+struct rec {
+   uint32_t sel, nsin;
+   uint64_t sin[4];
+   size_t stinsz;
+   uint8_t stin[4096];
+};
+
+struct fake {
+   struct rec calls[64];
+   unsigned ncalls;
+   int next_kr;         /* returned by every call */
+   uint64_t seq;        /* Submit returns ++seq */
+   unsigned busy_polls; /* WaitSeq reports busy this many times */
+   uint64_t now;
+   uint64_t last_wait_rel;
+   unsigned wait_calls;
+};
+
+static int
+fake_call(void *ctx, uint32_t sel, const uint64_t *sin, uint32_t nsin, const void *stin, size_t stinsz,
+          uint64_t *sout, uint32_t *nsout, void *stout, size_t *stoutsz)
+{
+   struct fake *f = ctx;
+   if (f->ncalls < 64) {
+      struct rec *r = &f->calls[f->ncalls++];
+      r->sel = sel;
+      r->nsin = nsin;
+      for (uint32_t i = 0; i < nsin && i < 4; i++)
+         r->sin[i] = sin[i];
+      r->stinsz = stinsz;
+      memcpy(r->stin, stin, stinsz < sizeof(r->stin) ? stinsz : sizeof(r->stin));
+   }
+   if (f->next_kr)
+      return f->next_kr;
+   switch (sel) {
+   case ACD_SEL_SUBMIT:
+      sout[0] = ++f->seq;
+      *nsout = 1;
+      break;
+   case ACD_SEL_WAIT_SEQ:
+      f->wait_calls++;
+      f->last_wait_rel = sin[1];
+      f->now += sin[1]; /* the kernel waited the whole slice when busy */
+      sout[0] = f->busy_polls ? (f->busy_polls--, 1) : 0;
+      sout[1] = 0;
+      sout[2] = f->seq;
+      *nsout = 3;
+      break;
+   case ACD_SEL_HELLO:
+      sout[0] = 1; sout[1] = 601; sout[2] = 64; sout[3] = 8;
+      *nsout = 4;
+      break;
+   case ACD_SEL_CTX:
+      memset(stout, 0, *stoutsz);
+      ((struct n48n_ctx *)stout)->op = 7;
+      break;
+   default:
+      break;
+   }
+   return 0;
+}
+
+static uint64_t
+fake_now(void *ctx)
+{
+   return ((struct fake *)ctx)->now;
+}
+
+static struct acd_kext *
+mk(struct fake *f)
+{
+   memset(f, 0, sizeof(*f));
+   struct acd_kext_ops ops = {.call = fake_call, .now_ns = fake_now};
+   return acd_kext_create(&ops, f);
+}
+
+static void
+test_errno_map(void)
+{
+   CHECK(acd_kr_to_errno(3, 0) == 0);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_BAD_ARGUMENT) == -EINVAL);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_NOT_FOUND) == -ENOENT);
+   CHECK(acd_kr_to_errno(5, (int)ACD_KR_UNSUPPORTED) == -EINVAL);
+   CHECK(acd_kr_to_errno(ACD_SEL_HELLO, (int)ACD_KR_UNSUPPORTED) == -ENODEV);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_NO_MEMORY) == -ENOMEM);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_NO_RESOURCES) == -ENOMEM);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_NOT_READY) == -ENODEV);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_EXCLUSIVE_ACCESS) == -EBUSY);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_NOT_PRIVILEGED) == -EACCES);
+   CHECK(acd_kr_to_errno(3, (int)ACD_KR_NOT_PERMITTED) == -EACCES);
+   CHECK(acd_kr_to_errno(7, (int)ACD_KR_TIMEOUT) == -ETIME);
+   CHECK(acd_kr_to_errno(7, (int)ACD_KR_ABORTED) == -ECANCELED);
+   CHECK(acd_kr_to_errno(7, 0x10000003) == -ENODEV);      /* MACH_SEND_INVALID_DEST */
+   CHECK(acd_kr_to_errno(7, 0x10004003) == -ENODEV);      /* MACH_RCV_* */
+   CHECK(acd_kr_to_errno(7, -300) == -ENODEV);            /* MIG_SERVER_DIED */
+   CHECK(acd_kr_to_errno(7, (int)0xe0001234u) == -EIO);   /* anything else (+ stderr line) */
+}
+
+static void
+test_timeouts(void)
+{
+   CHECK(acd_wait_slice_ns(ACD_TIMEOUT_INFINITE, 123) == N48N_WAIT_CAP_NS);
+   CHECK(acd_wait_slice_ns(1000, 2000) == 0);                       /* already passed: clamp at 0 */
+   CHECK(acd_wait_slice_ns(1000, 1000) == 0);
+   CHECK(acd_wait_slice_ns(5000, 1000) == 4000);
+   CHECK(acd_wait_slice_ns(10ull * 1000000000ull, 0) == N48N_WAIT_CAP_NS); /* capped at 2 s */
+   CHECK(!acd_wait_expired(ACD_TIMEOUT_INFINITE, ~0ull - 1));
+   CHECK(acd_wait_expired(1000, 1000) && !acd_wait_expired(1000, 999));
+   CHECK(acd_canon_bits_ok(0xffff800100000000ull) && acd_canon_bits_ok(0x00007fffffffffffull));
+   CHECK(!acd_canon_bits_ok(0x0000800000000000ull) && !acd_canon_bits_ok(0xffff000000000000ull));
+   CHECK(acd_cs_split_count(1) == 1 && acd_cs_split_count(64) == 1 && acd_cs_split_count(65) == 2 &&
+         acd_cs_split_count(192) == 3);
+}
+
+/* -- chunk builder -- */
+struct cs_build {
+   struct drm_amdgpu_cs_chunk chunk[300];
+   uint64_t ptr[300];
+   struct drm_amdgpu_cs_chunk_ib ib[200];
+   struct drm_amdgpu_cs_chunk_fence fence[2];
+   struct drm_amdgpu_cs_chunk_sem sem_in[3], sem_out[2];
+   struct drm_amdgpu_cs_chunk_syncobj tl_wait[2], tl_sig[2];
+   struct drm_amdgpu_bo_list_in bol;
+   unsigned n;
+};
+
+static void
+add(struct cs_build *b, uint32_t id, uint32_t dw, const void *data)
+{
+   b->chunk[b->n] = (struct drm_amdgpu_cs_chunk){.chunk_id = id, .length_dw = dw, .chunk_data = (uint64_t)(uintptr_t)data};
+   b->ptr[b->n] = (uint64_t)(uintptr_t)&b->chunk[b->n];
+   b->n++;
+}
+
+static void
+add_ibs(struct cs_build *b, unsigned n)
+{
+   for (unsigned i = 0; i < n; i++) {
+      b->ib[i] = (struct drm_amdgpu_cs_chunk_ib){.flags = i & 2, .va_start = 0xffff800100001000ull + 0x1000 * i,
+                                                 .ib_bytes = 64 + 4 * i, .ip_type = 0, .ip_instance = 0, .ring = 0};
+      add(b, AMDGPU_CHUNK_ID_IB, sizeof(b->ib[0]) / 4, &b->ib[i]);
+   }
+}
+
+static void
+test_chunks(void)
+{
+   static struct cs_build b;
+   struct acd_cs_plan p;
+
+   /* the full RADV mix */
+   memset(&b, 0, sizeof(b));
+   add_ibs(&b, 3);
