+fn raw_pointer_through_aggregate_helper_words(byte_offset: u32) -> Vec<String> {
+    let ll = raw_pointer_through_aggregate_helper_ll(byte_offset);
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_raw_ptr_aggregate_helper_{}_{byte_offset}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_sanitized_native(&ll, Stage::Kernel, &tmp).expect("translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    assert!(!asm.contains(" Private"), "{asm}");
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&spv, &tmp).expect("spirv-val");
+    }
+    let _ = std::fs::remove_dir_all(&tmp);
+    // Each constant word index of every `uint` storage-buffer access chain, in program order.
+    let words = |line: &str| {
+        line.split_whitespace()
+            .map(str::to_string)
+            .collect::<Vec<_>>()
+    };
+    let uint_ty = asm
+        .lines()
+        .map(words)
+        .find(|w| {
+            w.get(2).is_some_and(|op| op == "OpTypeInt")
+                && w.get(3..) == Some(&["32".into(), "0".into()][..])
+        })
+        .map(|w| w[0].clone())
+        .expect("uint type");
+    let uint_ptrs = asm
+        .lines()
+        .map(words)
+        .filter(|w| {
+            w.get(2).is_some_and(|op| op == "OpTypePointer")
+                && w.get(3).is_some_and(|sc| sc == "StorageBuffer")
+                && w.get(4) == Some(&uint_ty)
+        })
+        .map(|w| w[0].clone())
+        .collect::<Vec<_>>();
+    let constants = asm
+        .lines()
+        .map(words)
+        .filter(|w| w.get(2).is_some_and(|op| op == "OpConstant") && w.get(3) == Some(&uint_ty))
+        .map(|w| (w[0].clone(), w[4].clone()))
+        .collect::<HashMap<_, _>>();
+    asm.lines()
+        .map(words)
+        .filter(|w| {
+            w.get(2).is_some_and(|op| op.ends_with("AccessChain")) && uint_ptrs.contains(&w[3])
+        })
+        .filter_map(|w| constants.get(w.last()?).cloned())
+        .collect()
+}
