+entry:
+  %i0 = insertvalue %S poison, ptr addrspace(1) %a, 0, 0
+  %i1 = insertvalue %S %i0, ptr addrspace(2) %b, 1, 0
+  %i2 = insertvalue %S %i1, ptr addrspace(2) %p, 2
