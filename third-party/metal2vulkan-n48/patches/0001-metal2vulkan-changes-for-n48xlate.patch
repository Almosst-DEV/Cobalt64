+/// A helper that only stores a byte-offset raw buffer pointer into an aggregate and returns it
+/// (the Core Image `_ci_sampler_builder` shape), whose consumer extracts the field and reads
+/// through typed GEPs, must keep the pointer's byte cursor across both inline hops. The entry's own
+/// raw reads (bytes 16 and 144) are what make the consumer's typed parameter use look non-raw.
+fn raw_pointer_through_aggregate_helper_ll(byte_offset: u32) -> String {
+    format!(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+%tex = type {{ ptr addrspace(1) }}
+%smp = type {{ ptr addrspace(2) }}
+%S = type {{ %tex, %smp, ptr addrspace(2), <2 x float> }}
+%mat = type {{ [2 x <4 x float>] }}
+define void @k(ptr addrspace(2) %buffer0, ptr addrspace(1) %out) {{
+entry:
+  %o16 = getelementptr inbounds i8, ptr addrspace(2) %buffer0, i64 16
+  %l16 = load <4 x float>, ptr addrspace(2) %o16, align 16
+  %o144 = getelementptr i8, ptr addrspace(2) %buffer0, i64 144
+  %l144 = load float, ptr addrspace(2) %o144, align 4
+  %cursor = getelementptr i8, ptr addrspace(2) %buffer0, i64 {byte_offset}
+  %alias = bitcast ptr addrspace(2) %cursor to ptr addrspace(2)
+  %built = call fastcc %S @build(ptr addrspace(1) %out, ptr addrspace(2) %buffer0, ptr addrspace(2) %alias, <2 x float> zeroinitializer)
+  %f0 = extractvalue %S %built, 0
+  %f1 = extractvalue %S %built, 1
+  %f2 = extractvalue %S %built, 2
+  %f3 = extractvalue %S %built, 3
+  %v = call fastcc <4 x float> @consume(%tex %f0, %smp %f1, ptr addrspace(2) %f2, <2 x float> %f3)
+  %first0 = extractelement <4 x float> %v, i64 0
+  %e = extractelement <4 x float> %l16, i64 1
+  %fs = fadd float %first0, %e
+  %first = fadd float %fs, %l144
+  store float %first, ptr addrspace(1) %out, align 4
+  ret void
+}}
+define internal fastcc %S @build(ptr addrspace(1) %a, ptr addrspace(2) %b, ptr addrspace(2) %p, <2 x float> %c) {{
+entry:
+  %i0 = insertvalue %S poison, ptr addrspace(1) %a, 0, 0
+  %i1 = insertvalue %S %i0, ptr addrspace(2) %b, 1, 0
+  %i2 = insertvalue %S %i1, ptr addrspace(2) %p, 2
+  %i3 = insertvalue %S %i2, <2 x float> %c, 3
+  ret %S %i3
+}}
+define internal fastcc <4 x float> @consume(%tex %t, %smp %s, ptr addrspace(2) %p, <2 x float> %c) {{
+entry:
+  %c0 = getelementptr inbounds %mat, ptr addrspace(2) %p, i64 0, i32 0, i64 0
+  %v0 = load <4 x float>, ptr addrspace(2) %c0, align 16
+  %c1 = getelementptr inbounds %mat, ptr addrspace(2) %p, i64 0, i32 0, i64 1
+  %v1 = load <4 x float>, ptr addrspace(2) %c1, align 16
+  %v = fadd <4 x float> %v0, %v1
+  ret <4 x float> %v
+}}
+!air.kernel = !{{!0}}
+!0 = !{{ptr @k, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4}}
+!3 = !{{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 2, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4", !"air.arg_name", !"buffer0"}}
+!4 = !{{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_name", !"float", !"air.arg_name", !"out"}}
+"#
+    )
+}
