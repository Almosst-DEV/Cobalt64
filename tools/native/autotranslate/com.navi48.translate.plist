<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.navi48.translate</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/usr/local/navi48/pc-translate.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
