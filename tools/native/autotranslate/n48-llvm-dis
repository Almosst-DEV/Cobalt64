#!/bin/sh
# llvm-dis stand-in for metal2vulkan (METAL2VULKAN_LLVM_DIS), built on Apple CommandLineTools clang.
# usage: n48-llvm-dis SRC.air -o OUT.ll
# clang -x ir overrides the module's target lines with the host's; restore the AIR values (the datalayout is the
# executable source-layout contract metal2vulkan reads; the triple is rewritten by its sanitizer anyway).
[ "$2" = "-o" ] || { echo "usage: $0 SRC -o OUT" >&2; exit 2; }
CLANG=/Library/Developer/CommandLineTools/usr/bin/clang; [ -x "$CLANG" ] || CLANG=/usr/bin/clang   # the CLT binary directly: the /usr/bin shim needs xcrun's cache in /var/folders (denied in the sandbox)
"$CLANG" -Wno-override-module -S -emit-llvm -x ir "$1" -o "$3.clang" || exit 1
sed -e 's|^target datalayout = .*|target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"|' \
    -e 's|^target triple = .*|target triple = "air64_v28-apple-macosx26.6.0"|' "$3.clang" > "$3"; rc=$?
rm -f "$3.clang"; exit $rc
