#!/bin/bash
D=${FAKE_DIR:?}; S=$D/st
case "$*" in
 "-x WindowServer") [ -f "$D/wspid" ] || exit 1; if [ -f "$S/restarted" ] && [ -n "${FAKE_WS_CHANGE:-}" ]; then n=$(cat "$S/pg" 2>/dev/null || echo 0); n=$((n+1)); echo $n >"$S/pg"; [ $n -ge 4 ] && { echo 7777; exit 0; }; fi; cat "$D/wspid" ;;
 "-f n48-autoarm-watch.sh") [ -f "$S/watcher" ] && echo 9999 || exit 1 ;;
 *) exit 1 ;;
esac
